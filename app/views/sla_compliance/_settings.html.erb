<%# Global plugin settings. The two admin-managed lookups below feed the SLA policy form %>
<%# (Phase 4); the access allow-lists at the bottom are Step 5.1. %>
<%# Locals: settings (the plugin's stored Hash, saved via Setting.plugin_redmine_sla_compliance). %>
<p>
  <label for="settings_sweep_interval_minutes"><%= l(:field_sla_sweep_interval_minutes) %></label>
  <%= number_field_tag 'settings[sweep_interval_minutes]',
        settings['sweep_interval_minutes'].presence || Sla::PluginSettings::DEFAULT_SWEEP_INTERVAL_MINUTES,
        min: Sla::PluginSettings::MIN_SWEEP_INTERVAL_MINUTES,
        max: Sla::PluginSettings::MAX_SWEEP_INTERVAL_MINUTES,
        id: 'settings_sweep_interval_minutes', size: 6 %>
  <em class="info"><%= l(:text_sla_sweep_interval_hint) %></em>
</p>
<p>
  <label for="settings_unclassified_priority_id"><%= l(:field_sla_unclassified_priority) %></label>
  <%= select_tag 'settings[unclassified_priority_id]',
        options_for_select(
          [[l(:label_sla_unclassified_priority_auto), '']] +
            IssuePriority.all.map { |p| [p.name, p.id] },
          settings['unclassified_priority_id'].presence
        ),
        id: 'settings_unclassified_priority_id' %>
  <em class="info"><%= l(:text_sla_unclassified_priority_hint) %></em>
</p>
<%# Step 7.1 — instance-wide fallback for projects that haven't set their own webhook under %>
<%# Project Settings → SLA Policy → Notifications. Plain Redmine admin markup like the rows %>
<%# above; the .sla-plugin Tailwind scope starts at the access-control fieldset below. %>
<p>
  <label for="settings_google_chat_webhook"><%= l(:field_sla_global_google_chat_webhook) %></label>
  <%= url_field_tag 'settings[google_chat_webhook]', settings['google_chat_webhook'],
        id: 'settings_google_chat_webhook', size: 60,
        placeholder: l(:text_sla_webhook_placeholder) %>
  <em class="info"><%= l(:text_sla_global_google_chat_webhook_hint) %></em>
</p>
<p>
  <%= link_to l(:label_sla_target_options), sla_target_options_path %><br>
  <em class="info"><%= l(:text_sla_target_options_hint) %></em>
</p>
<p>
  <%= link_to l(:label_sla_business_calendars), sla_business_calendars_path %><br>
  <em class="info"><%= l(:text_sla_business_calendars_hint) %></em>
</p>

<%# --- Step 5.1: access control ------------------------------------------------------------ %>
<%# Redmine grants permissions to ROLES only. These two lists add the user-level grant it has no %>
<%# way to express; Sla::AccessControl + UserPatch turn them into permissions. Admins always have %>
<%# access and are not listed here. Only this section is wrapped in .sla-plugin — the settings %>
<%# above keep Redmine's own admin-form markup. %>
<%= render 'sla_compliance/assets' %>
<% content_for :header_tags do %>
  <%= javascript_include_tag 'sla_access_form.js', plugin: 'redmine_sla_compliance' %>
<% end %>

<fieldset class="box">
  <legend><%= l(:label_sla_access_control) %></legend>
  <div class="sla-plugin">
    <p class="tw-text-sm tw-text-gray-500 tw-mb-4"><%= l(:text_sla_access_control_hint) %></p>
    <div class="tw-grid tw-grid-cols-1 md:tw-grid-cols-2 tw-gap-4">
      <% { viewer: :field_sla_viewer_users, manager: :field_sla_manager_users }.each do |list, label_key| %>
        <%= render 'sla_compliance/user_list', list: list, label_key: label_key %>
      <% end %>
    </div>
  </div>
</fieldset>

<%# --- Update Frequency: system / service accounts ------------------------------------------- %>
<%# NOT an access grant, which is why it is its own fieldset rather than a third column above: %>
<%# these are the accounts whose comments the Update Frequency target must NOT treat as a human %>
<%# status update (Sla::UpdateFrequencyEvaluator). A REST-API integration is an ordinary Redmine %>
<%# user account, so only an admin can say which accounts those are — nothing in the data infers %>
<%# it, and nothing here is hard-coded (Global Rule 1). Same list component as above. %>
<fieldset class="box">
  <legend><%= l(:label_sla_system_accounts) %></legend>
  <div class="sla-plugin">
    <p class="tw-text-sm tw-text-gray-500 tw-mb-4"><%= l(:text_sla_system_accounts_hint) %></p>
    <%# The same two-column grid as the access lists above, with one cell filled: it keeps this %>
    <%# list the same width as those, and uses only utilities the scoped stylesheet already ships %>
    <%# (no Tailwind rebuild needed to render it). %>
    <div class="tw-grid tw-grid-cols-1 md:tw-grid-cols-2 tw-gap-4">
      <%= render 'sla_compliance/user_list', list: :system_account,
                 label_key: :field_sla_system_account_users %>
    </div>
  </div>
</fieldset>
