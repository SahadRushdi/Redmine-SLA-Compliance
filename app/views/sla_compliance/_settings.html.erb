<%# Global plugin settings. The two admin-managed lookups below feed the SLA policy form %>
<%# (Phase 4); the access allow-lists at the bottom are Step 5.1. %>
<%# Locals: settings (the plugin's stored Hash, saved via Setting.plugin_redmine_sla_compliance). %>
<p>
  <label for="settings_sweep_interval_minutes"><%= l(:field_sla_sweep_interval_minutes) %></label>
  <%= number_field_tag 'settings[sweep_interval_minutes]',
        settings['sweep_interval_minutes'].presence || Sla::PluginSettings::DEFAULT_SWEEP_INTERVAL_MINUTES,
        min: Sla::PluginSettings::MIN_SWEEP_INTERVAL_MINUTES,
        max: Sla::PluginSettings::MAX_SWEEP_INTERVAL_MINUTES,
        id: 'settings_sweep_interval_minutes', size: 6 %>
  <em class="info"><%= l(:text_sla_sweep_interval_hint) %></em>
</p>
<p>
  <label for="settings_unclassified_priority_id"><%= l(:field_sla_unclassified_priority) %></label>
  <%= select_tag 'settings[unclassified_priority_id]',
        options_for_select(
          [[l(:label_sla_unclassified_priority_auto), '']] +
            IssuePriority.all.map { |p| [p.name, p.id] },
          settings['unclassified_priority_id'].presence
        ),
        id: 'settings_unclassified_priority_id' %>
  <em class="info"><%= l(:text_sla_unclassified_priority_hint) %></em>
</p>
<%# Step 7.1 — instance-wide fallback for projects that haven't set their own webhook under %>
<%# Project Settings → SLA Policy → Notifications. Plain Redmine admin markup like the rows %>
<%# above; the .sla-plugin Tailwind scope starts at the access-control fieldset below. %>
<p>
  <label for="settings_google_chat_webhook"><%= l(:field_sla_global_google_chat_webhook) %></label>
  <%= url_field_tag 'settings[google_chat_webhook]', settings['google_chat_webhook'],
        id: 'settings_google_chat_webhook', size: 60,
        placeholder: l(:text_sla_webhook_placeholder) %>
  <em class="info"><%= l(:text_sla_global_google_chat_webhook_hint) %></em>
</p>
<p>
  <%= link_to l(:label_sla_target_options), sla_target_options_path %><br>
  <em class="info"><%= l(:text_sla_target_options_hint) %></em>
</p>
<p>
  <%= link_to l(:label_sla_business_calendars), sla_business_calendars_path %><br>
  <em class="info"><%= l(:text_sla_business_calendars_hint) %></em>
</p>

<%# --- Step 5.1: access control ------------------------------------------------------------ %>
<%# Redmine grants permissions to ROLES only. These two lists add the user-level grant it has no %>
<%# way to express; Sla::AccessControl + UserPatch turn them into permissions. Admins always have %>
<%# access and are not listed here. Only this section is wrapped in .sla-plugin — the settings %>
<%# above keep Redmine's own admin-form markup. %>
<%= render 'sla_compliance/assets' %>
<% content_for :header_tags do %>
  <%= javascript_include_tag 'sla_access_form.js', plugin: 'redmine_sla_compliance' %>
<% end %>

<fieldset class="box">
  <legend><%= l(:label_sla_access_control) %></legend>
  <div class="sla-plugin">
    <p class="tw-text-sm tw-text-gray-500 tw-mb-4"><%= l(:text_sla_access_control_hint) %></p>
    <div class="tw-grid tw-grid-cols-1 md:tw-grid-cols-2 tw-gap-4">
      <% { viewer: :field_sla_viewer_users, manager: :field_sla_manager_users }.each do |list, label_key| %>
        <% users = Sla::PluginSettings.public_send(:"#{list}_users").to_a %>
        <%# data-sla-users seeds sla_access_form.js's in-memory state (add/sort/paginate/delete); %>
        <%# everything server-rendered below is the no-JS-safe fallback the JS then replaces. %>
        <div data-sla-access-list="<%= list %>"
             data-sla-users="<%= users.map { |u| { id: u.id, name: u.name, login: u.login, mail: u.mail } }.to_json %>">
          <label for="sla-<%= list %>-users" class="<%= sla_label_classes %>"><%= l(label_key) %></label>
          <%# Search-only: picking a result adds a row to the table below instead of showing a %>
          <%# chip here -- the table is the single place a granted user is shown. %>
          <%= content_tag :select, '', id: "sla-#{list}-users",
                data: { sla_user_search: sla_access_users_path } %>
          <p class="tw-mt-1 tw-text-xs tw-text-gray-500"><%= l(:"text_sla_#{list}_users_hint") %></p>

          <%# Sentinel: guarantees the [] param is still posted once every row is removed, so %>
          <%# clearing a list persists as empty instead of leaving the old list untouched. %>
          <%= hidden_field_tag "settings[sla_#{list}_user_ids][]", '', id: nil %>
          <%# Server-rendered so the form still submits the current grants unchanged even if JS %>
          <%# never runs; sla_access_form.js fully replaces this container's contents on every %>
          <%# add/remove once it boots. %>
          <div data-sla-hidden-inputs>
            <% users.each do |user| %>
              <%= hidden_field_tag "settings[sla_#{list}_user_ids][]", user.id, id: nil %>
            <% end %>
          </div>

          <%# Deliberately a bare table, not a Flowbite component. Server-rendered as a %>
          <%# read-only, unsorted, unpaginated fallback; sla_access_form.js replaces the body %>
          <%# with a sortable, paginated, delete-capable version once it boots. %>
          <table class="tw-mt-2 tw-w-full tw-text-sm tw-border tw-border-gray-200">
            <thead>
              <tr class="tw-border-b tw-border-gray-200 tw-text-left tw-text-gray-500">
                <% [[:name, :label_user], [:login, :field_login], [:mail, :field_mail]].each do |key, header_label_key| %>
                  <th class="tw-p-1.5 tw-cursor-pointer tw-select-none" data-sla-sort="<%= key %>">
                    <%= l(header_label_key) %> <span data-sla-sort-indicator></span>
                  </th>
                <% end %>
                <th class="tw-p-1.5"></th>
              </tr>
            </thead>
            <tbody data-sla-rows>
              <% users.each do |user| %>
                <tr class="tw-border-b tw-border-gray-100 last:tw-border-0">
                  <td class="tw-p-1.5"><%= h user.name %></td>
                  <td class="tw-p-1.5"><%= h user.login %></td>
                  <td class="tw-p-1.5"><%= h user.mail %></td>
                  <td class="tw-p-1.5"></td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <p class="tw-mt-2 tw-text-xs tw-text-gray-400<%= ' hidden' if users.present? %>" data-sla-empty>
            <%= l(:label_sla_no_users_added) %>
          </p>
          <%# Same markup/classes as Redmine::Pagination::Helper#pagination_links_full (see e.g. %>
          <%# the Users admin list) so Purplemine2's own .pagination/.pages/.icon-del CSS styles %>
          <%# it identically -- sla_access_form.js only swaps real page links for click handlers. %>
          <span class="pagination" data-sla-pagination></span>
        </div>
      <% end %>
    </div>
  </div>
</fieldset>
