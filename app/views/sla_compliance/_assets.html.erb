<%# Loads the scoped plugin assets. Rendered from plugin views only, so Tailwind/Flowbite/ %>
<%# Tom Select never enter Redmine's global layout. Emits into <head> via :header_tags. %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'tailwind.output.css', plugin: 'redmine_sla_compliance' %>
  <%= stylesheet_link_tag 'tom-select.min.css', plugin: 'redmine_sla_compliance' %>
  <%= javascript_include_tag 'flowbite.min.js', plugin: 'redmine_sla_compliance' %>
  <%= javascript_include_tag 'tom-select.complete.min.js', plugin: 'redmine_sla_compliance' %>
  <%# Must load BEFORE any page script that builds a Tom Select — see the file's own header for %>
  <%# why Redmine's defaultFocus() otherwise leaves the first dropdown open on arrival. %>
  <%= javascript_include_tag 'sla_tom_select.js', plugin: 'redmine_sla_compliance' %>
  <%# chartjs-plugin-colorschemes is deliberately NOT loaded: every chart now supplies its own %>
  <%# colors (sla_chart_color for the donut/priority charts, hand-picked red/green in %>
  <%# _trend_chart.html.erb). The plugin self-registers globally against Chart on load and filled %>
  <%# in only the properties a dataset left unset — which meant the trend chart's points inherited %>
  <%# brewer.Paired12 blues (#a6cee3 / #1f78b4) as their pointBorderColor, drawing a blue ring %>
  <%# around every data point. Nothing opts into it, so it is gone rather than disabled per chart. %>
  <%= javascript_include_tag 'chart.min.js', plugin: 'redmine_sla_compliance' %>
<% end %>
