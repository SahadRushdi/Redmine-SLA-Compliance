<%# Instance-wide fallback configuration. Uses the exact project notification card partial. %>
<%= form_tag sla_global_notification_setting_path, method: :patch,
             id: 'sla-global-notification-form' do %>
  <%= render 'sla_notification_settings/fields', setting: SlaNotificationSetting.global_for_form %>
  <%= render 'sla_policies/save_bar', label: l(:button_sla_save_notifications) %>
<% end %>
