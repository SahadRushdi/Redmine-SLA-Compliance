<%# Administration → SLA Compliance. Hosts the General and Access control sections as panels, and %>
<%# carries the same sidebar as the Target options and Business calendars pages so the module never %>
<%# loses its navigation. See SlaSettingsController for why this is the plugin's own page rather %>
<%# than a settings partial rendered by Redmine's SettingsController#plugin. %>
<% current = sla_admin_current_panel %>

<%= render layout: 'sla_admin/shell', locals: { current: current } do %>
  <%# ONE form over both panels. Both are always in the DOM (only their visibility changes), so a %>
  <%# single submit saves the whole module's settings whichever section is open — which is also %>
  <%# why a panel must never be omitted rather than hidden: it would post nothing and its settings %>
  <%# would be cleared. %>
  <%= form_tag sla_settings_path, method: :patch, id: 'sla-settings-form' do %>
    <%# Kept in step with the open panel by sla_admin.js, so the redirect after saving returns to %>
    <%# the section the user was actually on. %>
    <%= hidden_field_tag 'section', current, id: 'sla-settings-section' %>

    <%= render layout: 'sla_admin/panel', locals: { key: 'general', current: current } do %>
      <%= render 'sla_settings/general', settings: @settings %>
    <% end %>

    <%= render layout: 'sla_admin/panel', locals: { key: 'access', current: current } do %>
      <%= render 'sla_settings/access' %>
    <% end %>

    <%= render 'sla_policies/save_bar', label: l(:button_save) %>
  <% end %>
<% end %>
