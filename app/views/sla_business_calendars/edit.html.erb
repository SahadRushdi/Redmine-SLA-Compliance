<h2><%= link_to l(:label_sla_business_calendars), sla_business_calendars_path %> &#187; <%= h @calendar.name %></h2>

<%= labelled_form_for @calendar, url: sla_business_calendar_path(@calendar), html: { method: :put } do |f| %>
  <%= render 'form', f: f %>
  <p><%= submit_tag l(:button_save) %></p>
<% end %>
