<%# Create/edit form for one business calendar. Locals: f (plain Rails builder — see the note in %>
<%# new.html.erb), cancel_path, submit_label. %>
<%= render 'sla_admin/form_errors', record: @calendar %>

<%= render layout: 'sla_policies/card',
           locals: { title: l(:label_sla_calendar_details),
                     description: l(:text_sla_calendar_details) } do %>
  <div class="tw-w-full md:tw-w-96">
    <%= render layout: 'sla_admin/field',
               locals: { label: l(:field_name), field_id: 'sla_business_calendar_name',
                         required: true } do %>
      <%= f.text_field :name, class: sla_input_classes %>
    <% end %>
  </div>
<% end %>

<%= render layout: 'sla_policies/card',
           locals: { title: l(:field_sla_working_days),
                     description: l(:text_sla_working_days_hint) } do %>
  <%# Seven checkboxes presented as selectable tiles, reusing .sla-option-card from the project %>
  <%# policy form (the :has(input:checked) selector there is input-type agnostic, so it works for %>
  <%# checkboxes unchanged) with a compact modifier so all seven fit one row. The param name and %>
  <%# the 1..7 ISO values are unchanged — only the presentation of the same checkboxes. %>
  <% selected_days = @calendar.working_days.to_a.map(&:to_i) %>
  <div class="tw-flex tw-flex-wrap tw-gap-2">
    <% (1..7).each do |day| %>
      <label class="sla-option-card sla-option-card--compact" for="sla-working-day-<%= day %>">
        <%= check_box_tag 'sla_business_calendar[working_days][]', day,
                          selected_days.include?(day), id: "sla-working-day-#{day}" %>
        <span><%= sla_weekday_name(day) %></span>
      </label>
    <% end %>
  </div>
<% end %>

<%= render layout: 'sla_policies/card',
           locals: { title: l(:field_sla_working_hours),
                     description: l(:text_sla_working_hours_hint) } do %>
  <%# Kept as text inputs with an HH:MM pattern rather than <input type="time">: the values are %>
  <%# stored as plain strings and existing rows may hold "9:00", which a time input silently %>
  <%# refuses to display (it requires zero-padded HH:MM) — the field would open blank and a save %>
  <%# would wipe a working calendar. %>
  <div class="tw-grid tw-grid-cols-1 sm:tw-grid-cols-2 tw-gap-x-5 tw-max-w-lg">
    <%= render layout: 'sla_admin/field',
               locals: { label: l(:field_sla_work_start_time),
                         field_id: 'sla_business_calendar_work_start_time' } do %>
      <%= f.text_field :work_start_time, class: sla_input_classes, placeholder: 'HH:MM',
                       pattern: '[0-9]{1,2}:[0-9]{2}', inputmode: 'numeric' %>
    <% end %>

    <%= render layout: 'sla_admin/field',
               locals: { label: l(:field_sla_work_end_time),
                         field_id: 'sla_business_calendar_work_end_time' } do %>
      <%= f.text_field :work_end_time, class: sla_input_classes, placeholder: 'HH:MM',
                       pattern: '[0-9]{1,2}:[0-9]{2}', inputmode: 'numeric' %>
    <% end %>
  </div>
<% end %>

<%= render layout: 'sla_policies/card',
           locals: { title: l(:field_sla_holidays),
                     description: l(:text_sla_holidays_chips_hint) } do %>
  <%# Chip input instead of the free-text textarea this replaces. Two reasons beyond looks: each %>
  <%# date is a discrete, individually removable value, and data-sla-date-chips makes sla_admin.js %>
  <%# refuse to create a chip that isn't a YYYY-MM-DD date — the same rule the model enforces %>
  <%# (SlaBusinessCalendar#holidays_are_valid), now stated before the round-trip instead of coming %>
  <%# back as a validation error on the whole record. %>
  <%# %>
  <%# Every stored date is rendered as a SELECTED option, so with JavaScript unavailable this %>
  <%# degrades to a native multi-select that still posts the existing list back unchanged rather %>
  <%# than silently clearing it. %>
  <% holidays = @calendar.holidays.to_a.map(&:to_s) %>
  <%= render layout: 'sla_admin/field',
             locals: { label: l(:field_sla_holidays), field_id: 'sla_business_calendar_holidays' } do %>
    <%# Sentinel: keeps the [] param posted once the last chip is removed, so clearing the list %>
    <%# persists as empty instead of leaving the stored holidays untouched. %>
    <%= hidden_field_tag 'sla_business_calendar[holidays][]', '', id: nil %>
    <%= select_tag 'sla_business_calendar[holidays][]',
          options_for_select(holidays, holidays),
          multiple: true, id: 'sla_business_calendar_holidays',
          data: { sla_date_chips: true, sla_chip_placeholder: l(:text_sla_holidays_placeholder) } %>
  <% end %>
<% end %>

<%= render 'sla_admin/form_actions', submit_label: submit_label, cancel_path: cancel_path %>
