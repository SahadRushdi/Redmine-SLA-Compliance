<%# Business calendars section of the SLA Compliance admin module. Same shell (and so the same %>
<%# persistent sidebar) as every other page of the module. %>
<%= render layout: 'sla_admin/shell', locals: { current: 'business_calendars' } do %>
  <%= render 'sla_admin/breadcrumb',
             crumbs: [[l(:label_sla_compliance_settings), sla_admin_section_path('general')],
                      [l(:label_sla_admin_section_business_calendars), nil]] %>

  <%= render 'sla_admin/page_header',
             title: l(:label_sla_business_calendars),
             description: l(:text_sla_business_calendars_hint),
             action_label: l(:label_sla_business_calendar_new),
             action_path: new_sla_business_calendar_path %>

  <% if @calendars.any? %>
    <%= render layout: 'sla_admin/data_table',
               locals: { headers: [l(:field_name), l(:field_sla_working_days),
                                   l(:field_sla_working_hours), l(:field_sla_holidays), ''] } do %>
      <% @calendars.each do |calendar| %>
        <% working_days = calendar.working_days.to_a.map(&:to_i).sort %>
        <tr>
          <td class="tw-font-medium tw-text-gray-900"><%= h calendar.name %></td>
          <td>
            <% if working_days.any? %>
              <%# All seven days are shown, with the non-working ones muted, so a calendar's shape %>
              <%# is readable at a glance instead of having to notice which names are missing from %>
              <%# a comma list. The full day name is the accessible name of each pill. %>
              <div class="tw-flex tw-flex-wrap tw-gap-1">
                <% (1..7).each do |day| %>
                  <span class="sla-admin-day-chip<%= ' is-on' if working_days.include?(day) %>"
                        title="<%= sla_weekday_name(day) %>"><%= sla_weekday_abbr(day) %></span>
                <% end %>
              </div>
            <% else %>
              <span class="tw-text-gray-400"><%= l(:label_sla_calendar_unset) %></span>
            <% end %>
          </td>
          <td>
            <% hours = [calendar.work_start_time, calendar.work_end_time].select(&:present?) %>
            <% if hours.size == 2 %>
              <%= h hours.join(' – ') %>
            <% else %>
              <span class="tw-text-gray-400"><%= l(:label_sla_calendar_unset) %></span>
            <% end %>
          </td>
          <td>
            <% count = calendar.holidays.to_a.size %>
            <% if count.positive? %>
              <%= sla_admin_badge(l(:label_sla_holiday_count, count: count)) %>
            <% else %>
              <span class="tw-text-gray-400"><%= l(:label_sla_calendar_unset) %></span>
            <% end %>
          </td>
          <td>
            <%= render 'sla_admin/row_actions',
                       edit_path: edit_sla_business_calendar_path(calendar),
                       delete_path: sla_business_calendar_path(calendar),
                       confirm: l(:text_are_you_sure) %>
          </td>
        </tr>
      <% end %>
    <% end %>
  <% else %>
    <%# An empty list here is the normal starting state, not a fault — so this is an empty state %>
    <%# that says what a calendar is for and offers the action, not the plain "no data" line (or %>
    <%# the warning-styled banner) it replaces. %>
    <%= render 'sla_admin/empty_state',
               icon: sla_admin_section_icon('business_calendars'),
               title: l(:label_sla_no_business_calendars_yet),
               description: l(:text_sla_no_business_calendars_yet),
               action_label: l(:label_sla_business_calendar_new),
               action_path: new_sla_business_calendar_path %>
  <% end %>
<% end %>
