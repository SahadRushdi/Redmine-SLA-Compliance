<div class="contextual">
  <%= link_to l(:label_sla_business_calendar_new), new_sla_business_calendar_path, class: 'icon icon-add' %>
</div>

<h2><%= l(:label_sla_business_calendars) %></h2>
<p class="info"><%= l(:text_sla_business_calendars_hint) %></p>

<% if @calendars.any? %>
  <table class="list">
    <thead>
      <tr>
        <th><%= l(:field_name) %></th>
        <th><%= l(:field_sla_working_days) %></th>
        <th><%= l(:field_sla_working_hours) %></th>
        <th><%= l(:field_sla_holidays) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @calendars.each do |calendar| %>
        <tr>
          <td><%= h calendar.name %></td>
          <td><%= calendar.working_days.to_a.map { |d| day_name(d.to_i % 7) }.join(', ') %></td>
          <td><%= h [calendar.work_start_time, calendar.work_end_time].select(&:present?).join(' – ') %></td>
          <td><%= calendar.holidays.to_a.size %></td>
          <td class="buttons">
            <%= link_to l(:button_edit), edit_sla_business_calendar_path(calendar), class: 'icon icon-edit' %>
            <%= link_to l(:button_delete), sla_business_calendar_path(calendar),
                        method: :delete, data: { confirm: l(:text_are_you_sure) },
                        class: 'icon icon-del' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
