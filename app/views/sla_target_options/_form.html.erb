<%# Create/edit form for one target option. Locals: f (a plain Rails form builder — deliberately %>
<%# NOT labelled_form_for, whose builder emits Redmine's own <label> markup and would fight the %>
<%# module's field layout), cancel_path, submit_label. %>
<%# %>
<%# Field names and the params the controller permits are unchanged; this is presentation only. %>
<%= render 'sla_admin/form_errors', record: @target_option %>

<%= render layout: 'sla_policies/card',
           locals: { title: l(:label_sla_target_option_details),
                     description: l(:text_sla_target_option_details) } do %>
  <div class="tw-grid tw-grid-cols-1 md:tw-grid-cols-2 tw-gap-x-5">
    <%= render layout: 'sla_admin/field',
               locals: { label: l(:field_sla_target_type), field_id: 'sla_target_option_target_type',
                         required: true } do %>
      <%= f.select :target_type,
                   SlaTargetOption::TARGET_TYPES.map { |t| [sla_target_type_label(t), t] },
                   {}, class: sla_input_classes, data: { sla_select: true } %>
    <% end %>

    <%= render layout: 'sla_admin/field',
               locals: { label: l(:field_sla_code), field_id: 'sla_target_option_code',
                         hint: l(:text_sla_code_hint), required: true } do %>
      <%= f.text_field :code, class: sla_input_classes %>
    <% end %>

    <%# Spans both columns: the label is the human-facing name of the option and gets the room. %>
    <div class="md:tw-col-span-2">
      <%= render layout: 'sla_admin/field',
                 locals: { label: l(:field_sla_option_label), field_id: 'sla_target_option_label',
                           required: true } do %>
        <%= f.text_field :label, class: sla_input_classes %>
      <% end %>
    </div>

    <%= render layout: 'sla_admin/field',
               locals: { label: l(:field_sla_basis), field_id: 'sla_target_option_basis',
                         hint: l(:text_sla_basis_hint), required: true } do %>
      <%= f.select :basis,
                   SlaTargetOption::BASES.map { |b| [l("label_sla_basis_#{b}"), b] },
                   {}, class: sla_input_classes, data: { sla_select: true } %>
    <% end %>

    <%= render layout: 'sla_admin/field',
               locals: { label: l(:field_sla_position), field_id: 'sla_target_option_position',
                         hint: l(:text_sla_position_hint) } do %>
      <%= f.number_field :position, class: sla_input_classes %>
    <% end %>
  </div>
<% end %>

<%= render layout: 'sla_policies/card',
           locals: { title: l(:field_sla_duration),
                     description: l(:text_sla_target_option_duration_card) } do %>
  <%# Best Effort and the numeric duration are mutually exclusive by validation (a Best Effort %>
  <%# option must have NO seconds), so the switch HIDES the seconds field rather than leaving both %>
  <%# on screen with a "leave blank when checked" note under one of them. The controller still %>
  <%# nils seconds server-side — this is an affordance, not the enforcement. %>
  <div class="tw-flex tw-items-center tw-justify-between tw-gap-4">
    <div class="tw-min-w-0">
      <p class="tw-m-0 tw-text-sm tw-font-medium tw-text-gray-900"><%= l(:field_sla_best_effort) %></p>
      <p class="tw-mt-1 tw-mb-0 tw-text-xs tw-text-gray-500"><%= l(:text_sla_best_effort_hint) %></p>
    </div>
    <%# data-sla-reveals is inverted here by the `!` prefix: the block is shown while the switch is %>
    <%# OFF. sla_admin.js reads that convention; see the file for why it lives in the attribute %>
    <%# rather than as a second attribute. %>
    <%= render 'sla_compliance/toggle', name: 'sla_target_option[best_effort]',
               checked: @target_option.best_effort?, reveals: '!duration' %>
  </div>

  <div data-sla-reveal="duration" class="tw-mt-5 <%= 'hidden' if @target_option.best_effort? %>">
    <div class="tw-w-full md:tw-w-64">
      <%= render layout: 'sla_admin/field',
                 locals: { label: l(:field_sla_seconds), field_id: 'sla_target_option_seconds',
                           hint: l(:text_sla_seconds_hint) } do %>
        <%= f.number_field :seconds, min: 1, class: sla_input_classes %>
      <% end %>
    </div>
  </div>
<% end %>

<%= render 'sla_admin/form_actions', submit_label: submit_label, cancel_path: cancel_path %>
