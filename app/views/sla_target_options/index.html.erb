<div class="contextual">
  <%= link_to l(:label_sla_target_option_new), new_sla_target_option_path, class: 'icon icon-add' %>
</div>

<h2><%= l(:label_sla_target_options) %></h2>
<p class="info"><%= l(:text_sla_target_options_hint) %></p>

<% if @target_options.any? %>
  <table class="list">
    <thead>
      <tr>
        <th><%= l(:field_sla_target_type) %></th>
        <th><%= l(:field_sla_code) %></th>
        <th><%= l(:field_sla_option_label) %></th>
        <th><%= l(:field_sla_duration) %></th>
        <th><%= l(:field_sla_basis) %></th>
        <th><%= l(:field_sla_position) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @target_options.each do |option| %>
        <tr>
          <td><%= sla_target_type_label(option.target_type) %></td>
          <td><%= h option.code %></td>
          <td><%= h option.label %></td>
          <td><%= option.best_effort? ? l(:field_sla_best_effort) : format_sla_duration(option.seconds) %></td>
          <td><%= l("label_sla_basis_#{option.basis}") %></td>
          <td><%= option.position %></td>
          <td class="buttons">
            <%= link_to l(:button_edit), edit_sla_target_option_path(option), class: 'icon icon-edit' %>
            <%= link_to l(:button_delete), sla_target_option_path(option),
                        method: :delete, data: { confirm: l(:text_are_you_sure) },
                        class: 'icon icon-del' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
