<h2><%= link_to l(:label_sla_target_options), sla_target_options_path %> &#187; <%= h @target_option.label %></h2>

<%= labelled_form_for @target_option, url: sla_target_option_path(@target_option), html: { method: :put } do |f| %>
  <%= render 'form', f: f %>
  <p><%= submit_tag l(:button_save) %></p>
<% end %>
