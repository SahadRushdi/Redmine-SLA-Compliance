<%# The policy half of the tab: either the read-only inherited-policy banner (B3) or the four %>
<%# editable policy sections. Locals: project, policy, current, inherited_source. %>
<%# %>
<%# This is the AJAX re-render target (with the nav slot) — see edit.js.erb. The Notifications %>
<%# panel is deliberately NOT in here: it belongs to a different controller and its own save %>
<%# button, so a clone load must not throw away text typed into it. %>
<% if inherited_source.present? %>
  <% source_project, source_policy = inherited_source %>
  <%= render 'sla_policies/inherited_banner',
             project: project, source_project: source_project, source_policy: source_policy %>
<% elsif User.current.allowed_to?(:edit_sla_policy, project) %>
  <% if SlaPolicy.source_for(project).first.nil? %>
    <p class="tw-text-sm tw-text-gray-500 tw-mb-4"><%= l(:text_sla_no_policy_anywhere_hint) %></p>
  <% end %>
  <%= render 'sla_policies/form', project: project, policy: policy, current: current %>
<% end %>
