<%# Measurement Rules body: three cards — milestone status chips, the first-response rule, and %>
<%# the at-risk threshold. Selections post as status IDs; an empty field skips that milestone. %>
<%# Rendered inside the section's own <form> (see _form.html.erb). Locals: project, policy. %>

<%= render layout: 'sla_policies/card',
           locals: { title: l(:label_sla_milestones_card) } do %>
  <% statuses = project.rolled_up_statuses %>
  <% { created: :field_sla_created_statuses,
       work_started: :field_sla_work_started_statuses,
       resolved: :field_sla_resolved_statuses }.each_with_index do |(role, label_key), index| %>
    <div class="<%= 'tw-mt-4' unless index.zero? %>">
      <label for="sla-status-<%= role %>" class="<%= sla_label_classes %>"><%= l(label_key) %></label>
      <%= select_tag "status_mappings[#{role}][]",
            options_from_collection_for_select(statuses, :id, :name, sla_status_ids(policy, role)),
            multiple: true, id: "sla-status-#{role}", data: { sla_chips: true } %>
    </div>
  <% end %>
<% end %>

<%# Each rule is a selectable tile rather than a bare radio, so the whole card is the click target. %>
<%# The selected border/tint is driven straight off the input's :checked state in CSS (see %>
<%# partials/_option_card.css) — no JS, so the highlight can never disagree with what is posted. %>
<%= render layout: 'sla_policies/card',
           locals: { title: l(:label_sla_first_response_card) } do %>
  <div class="tw-grid tw-grid-cols-1 md:tw-grid-cols-3 tw-gap-3">
    <% SlaPolicy::FIRST_RESPONSE_RULES.each do |rule| %>
      <label class="sla-option-card">
        <%= radio_button_tag 'sla_policy[first_response_rule]', rule,
              policy.first_response_rule == rule, class: sla_radio_classes %>
        <%= l("label_first_response_#{rule}") %>
      </label>
    <% end %>
  </div>
<% end %>

<%# The card heading is this field's visible label; the input also carries an aria-label. %>
<div class="tw-grid tw-grid-cols-1 md:tw-grid-cols-2 tw-gap-5">
  <%= render layout: 'sla_policies/card',
             locals: { title: l(:label_sla_at_risk_card) } do %>
    <div class="tw-flex tw-items-center tw-gap-2">
      <div class="tw-w-32">
        <%= number_field_tag 'sla_policy[at_risk_threshold]', policy.at_risk_threshold,
              min: 1, max: 100, id: 'sla_policy_at_risk_threshold', class: sla_input_classes,
              'aria-label': l(:field_at_risk_threshold) %>
      </div>
      <span class="tw-text-sm tw-text-gray-500">%</span>
    </div>
  <% end %>

<%# Step 6.2a — the Stale card's inactivity threshold, per project and inherited down the tree. %>
<%# Sits beside the at-risk threshold because both answer "at what point do we say something is %>
<%# wrong with this ticket"; the same input pattern is reused rather than a new one invented. %>
<%# %>
<%# EMPTY IS A REAL STATE here, not a missing value: it means "inherit", and it is how the user %>
<%# removes an override. The placeholder shows what would apply if the field is left empty. %>
  <%= render layout: 'sla_policies/card',
             locals: { title: l(:label_sla_stale_card) } do %>
    <% inherited = sla_inherited_stale_threshold(project) %>
    <%# Same single-control treatment as the at-risk card above: heading once, aria-label on the %>
    <%# input, no repeated "Stale after" label. %>
    <div class="tw-flex tw-items-center tw-gap-2">
      <div class="tw-w-32">
        <%= number_field_tag 'sla_policy[stale_threshold_days]', policy.stale_threshold_days,
              min: SlaPolicy::STALE_THRESHOLD_DAYS.min, max: SlaPolicy::STALE_THRESHOLD_DAYS.max,
              id: 'sla_policy_stale_threshold_days', class: sla_input_classes,
              'aria-label': l(:field_sla_stale_threshold_days_project),
              placeholder: sla_stale_threshold_placeholder(inherited) %>
      </div>
      <span class="tw-text-sm tw-text-gray-500"><%= l(:label_sla_days_suffix) %></span>
    </div>
  <% end %>
</div>
