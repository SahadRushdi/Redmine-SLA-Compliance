<%# Exclusions body: pause handling on/off and the statuses whose time is subtracted. %>
<%# Empty = no pauses. Rendered inside the section's own <form>. Locals: project, policy. %>
<%= render layout: 'sla_policies/card',
           locals: { title: l(:label_sla_pause_card),
                     description: l(:text_sla_pause_card) } do %>
  <%= render 'sla_policies/switch_row', name: 'sla_policy[pause_enabled]',
             checked: policy.pause_enabled?, title: l(:field_sla_pause_handling),
             description: l(:text_sla_pause_handling_hint) %>

  <div class="tw-mt-5">
    <label for="sla-status-pause" class="<%= sla_label_classes %>"><%= l(:field_sla_pause_statuses) %></label>
    <%= select_tag 'status_mappings[pause][]',
          options_from_collection_for_select(project.rolled_up_statuses, :id, :name,
                                             sla_status_ids(policy, :pause)),
          multiple: true, id: 'sla-status-pause', data: { sla_chips: true } %>
    <p class="tw-mt-1 tw-mb-0 tw-text-xs tw-text-gray-500"><%= l(:text_sla_pause_statuses_hint) %></p>
  </div>
<% end %>
