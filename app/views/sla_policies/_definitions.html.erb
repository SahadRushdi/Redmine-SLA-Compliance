<%# Step 4.4 — SLA targets per tracker × priority. Trackers come from the project; priorities %>
<%# and target durations are looked up live (Global Rules 1–3 — nothing hard-coded). %>
<div class="tw-bg-white tw-border tw-border-gray-200 tw-rounded-lg tw-shadow-sm tw-p-5 tw-mb-6">
  <h3 class="tw-text-base tw-font-semibold tw-text-gray-900 tw-mb-1"><%= l(:label_sla_definitions_section) %></h3>
  <p class="tw-text-xs tw-text-gray-500 tw-mb-4"><%= l(:text_sla_definitions_hint) %></p>

  <% trackers = project.trackers.to_a %>
  <% if trackers.empty? %>
    <p class="tw-text-sm tw-text-gray-500"><%= l(:text_sla_no_trackers) %></p>
  <% else %>
    <% tracker = sla_selected_tracker(project, policy) %>
    <div class="md:tw-w-64 tw-mb-4">
      <label for="sla-definitions-tracker" class="<%= sla_label_classes %>"><%= l(:field_sla_tracker) %></label>
      <%= select_tag 'definitions[tracker_id]',
            options_from_collection_for_select(trackers, :id, :name, tracker&.id),
            id: 'sla-definitions-tracker', class: sla_input_classes %>
    </div>

    <% if sla_target_options_by_type.empty? %>
      <p class="tw-text-sm tw-text-amber-700 tw-mb-3"><%= l(:text_sla_no_target_options) %></p>
    <% end %>

    <div class="tw-overflow-x-auto">
      <table class="tw-w-full tw-text-sm tw-text-left tw-text-gray-700">
        <thead class="tw-bg-gray-50 tw-text-gray-700">
          <tr>
            <th class="tw-px-4 tw-py-2 tw-font-medium"><%= l(:label_sla_priority) %></th>
            <th class="tw-px-4 tw-py-2 tw-font-medium"><%= l(:label_sla_target_response) %></th>
            <th class="tw-px-4 tw-py-2 tw-font-medium"><%= l(:label_sla_target_workaround) %></th>
            <th class="tw-px-4 tw-py-2 tw-font-medium"><%= l(:label_sla_target_resolution) %></th>
          </tr>
        </thead>
        <tbody id="sla-definitions-rows">
          <%= render 'sla_policies/definition_rows', policy: policy, tracker: tracker %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
