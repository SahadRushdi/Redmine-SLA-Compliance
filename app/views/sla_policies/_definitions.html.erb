<%# Step 4.4 — SLA targets per tracker × priority: a multi-tracker picker, then one Priority %>
<%# Targets table per selected tracker, all written by the section's single Save. Trackers come %>
<%# from the project; priorities and target durations are looked up live (Global Rules 1–3 — %>
<%# nothing hard-coded). Locals: project, policy. %>
<% trackers = project.trackers.sorted.to_a %>
<% if trackers.empty? %>
  <%= render layout: 'sla_policies/card',
             locals: { title: l(:label_sla_tracker_card) } do %>
    <p class="tw-m-0 tw-text-sm tw-text-gray-500"><%= l(:text_sla_no_trackers) %></p>
  <% end %>
<% else %>
  <% selected = sla_selected_trackers(project, policy) %>
  <% selected_ids = selected.map(&:id) %>
  <% configured_sources = policy.sla_definitions.map(&:tracker_id).uniq & selected_ids %>

  <%= render layout: 'sla_policies/card',
             locals: { title: l(:field_sla_trackers) } do %>
    <div class="tw-w-full">
      <%# data-sla-chips (not data-sla-select): the same Tom Select multi-select already used for %>
      <%# the milestone status pickers, so adding several trackers is one interaction and needs no %>
      <%# new component (CLAUDE.md — reuse what's already solved). Each selection adds that %>
      <%# tracker's table below via sla_policy_form.js; nothing is saved until Save Policy. %>
      <%= select_tag 'definitions[tracker_ids][]',
            options_from_collection_for_select(trackers, :id, :name, selected.map(&:id)),
            id: 'sla-definitions-trackers', multiple: true, class: sla_input_classes,
            placeholder: l(:label_sla_tracker_placeholder),
            data: { sla_chips: true, table_url: edit_project_sla_policy_path(project) } %>
    </div>
  <% end %>

  <div class="tw-mb-4 tw-rounded-lg tw-border tw-border-gray-200 tw-bg-white">
    <div class="tw-flex tw-flex-col tw-gap-3 tw-border-b tw-border-gray-200 tw-px-4 tw-pt-3
                md:tw-flex-row md:tw-items-end md:tw-justify-between">
      <div id="sla-tracker-tabs" class="tw-flex tw-min-w-0 tw-flex-wrap tw-gap-1" role="tablist"
           aria-label="<%= l(:field_sla_trackers) %>">
        <% selected.each_with_index do |tracker, index| %>
          <button type="button" role="tab" data-sla-tracker-tab="<%= tracker.id %>"
                  aria-selected="<%= index.zero? %>"
                  class="sla-tracker-tab<%= ' is-active' if index.zero? %>"><%= h tracker.name %></button>
        <% end %>
      </div>
      <% if configured_sources.any? %>
        <div class="tw-flex tw-shrink-0 tw-items-end tw-gap-2 tw-pb-3">
          <div class="tw-w-52">
            <label for="sla-clone-tracker-source" class="tw-sr-only"><%= l(:label_sla_clone_tracker_source) %></label>
            <%= select_tag 'sla_clone_tracker_source',
                  options_for_select([[l(:label_sla_clone_tracker_placeholder), '']] +
                    trackers.select { |tracker| configured_sources.include?(tracker.id) }
                            .map { |tracker| [tracker.name, tracker.id] }),
                  id: 'sla-clone-tracker-source',
                  class: "#{sla_input_classes} sla-clone-tracker-select",
                  data: { sla_select: true } %>
          </div>
          <button type="button" id="sla-clone-tracker-button"
                  data-endpoint="<%= clone_tracker_project_sla_policy_path(project) %>"
                  data-confirm="<%= l(:text_sla_clone_tracker_confirm) %>"
                  class="<%= sla_secondary_button_classes %>"><%= l(:button_sla_clone_tracker) %></button>
        </div>
      <% end %>
    </div>

  <div id="sla-definitions-tables" class="tw-p-4">
    <% selected.each_with_index do |tracker, index| %>
      <%= render 'sla_policies/definition_table', policy: policy, tracker: tracker,
                 hidden: index.positive? %>
    <% end %>
  </div>
  </div>
<% end %>
