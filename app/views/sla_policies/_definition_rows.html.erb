<%# One row per active priority, for ONE tracker's table (see _definition_table). A priority with %>
<%# every target unset gets no SlaDefinition row (it is excluded from SLA tracking). %>
<%# %>
<%# Field names are nested under the tracker id — definitions[rows][<tracker>][<priority>][<type>] %>
<%# — so several trackers' tables can post together in one submit. %>
<%# %>
<%# Locals: policy, tracker. %>
<% definitions = sla_definition_map(policy, tracker) %>
<% IssuePriority.active.each do |priority| %>
  <% definition = definitions[priority.id] %>
  <tr class="tw-border-b tw-border-gray-200">
    <%# Priority is rendered as its plain name. It deliberately carries NO severity colouring: any %>
    <%# such scale would be a severity encoding baked into the plugin, which Global Rule 1 forbids %>
    <%# ("no ... severity labels as constants or enums") — the priority's meaning and ordering %>
    <%# belong to the site's Redmine configuration, not to this code. %>
    <td class="tw-px-4 tw-py-2 tw-font-medium tw-text-gray-900"><%= h priority.name %></td>
    <%# One dropdown per target type, from the model's own list — Response, Workaround, Resolution %>
    <%# and Update Frequency are configured identically, so the column set follows the constant %>
    <%# rather than being re-typed here. Options come from the admin lookup in every case. %>
    <% SlaDefinition::TARGET_TYPES.each do |target_type| %>
      <% current_seconds     = definition&.public_send("#{target_type}_seconds") %>
      <% current_best_effort = definition&.best_effort?(target_type) %>
      <td class="tw-px-4 tw-py-2">
        <%= select_tag "definitions[rows][#{tracker.id}][#{priority.id}][#{target_type}]",
              sla_target_select_options(target_type, current_seconds, current_best_effort),
              id: "sla-def-#{tracker.id}-#{priority.id}-#{target_type}", class: sla_input_classes,
              data: { sla_select: true } %>
      </td>
    <% end %>
  </tr>
<% end %>
