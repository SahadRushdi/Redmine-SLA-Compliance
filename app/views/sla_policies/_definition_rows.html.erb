<%# Direct wall-clock target editor: one autosaved cell per tracker/priority/target. %>
<% definitions = sla_definition_map(policy, tracker) %>
<% IssuePriority.active.each do |priority| %>
  <% definition = definitions[priority.id] %>
  <tr class="tw-border-b tw-border-gray-200">
    <td class="tw-px-4 tw-py-2 tw-font-medium tw-text-gray-900"><%= h priority.name %></td>
    <% SlaDefinition::TARGET_TYPES.each do |target_type| %>
      <% seconds = definition&.public_send("#{target_type}_seconds") %>
      <% saved_unit = definition&.public_send("#{target_type}_unit") %>
      <% best_effort = definition&.best_effort?(target_type) || false %>
      <% amount, unit = sla_direct_duration_parts(seconds, saved_unit) %>
      <td class="tw-px-2 tw-py-2 tw-align-top">
        <div class="sla-target-cell tw-relative" data-sla-target-cell
             data-endpoint="<%= target_project_sla_policy_path(@project) %>"
             data-tracker-id="<%= tracker.id %>" data-priority-id="<%= priority.id %>"
             data-target-type="<%= target_type %>" data-seconds="<%= seconds %>"
             data-best-effort="<%= best_effort %>">
          <button type="button" data-sla-target-display
                  class="tw-w-full tw-min-h-9 tw-rounded-lg tw-border tw-border-gray-300 tw-bg-white
                         tw-px-3 tw-py-2 tw-text-left tw-text-sm tw-text-gray-900 hover:tw-bg-gray-50
                         focus:tw-ring-2 focus:tw-ring-primary-500">
            <%= sla_direct_duration_label(seconds, best_effort, saved_unit) %>
          </button>
          <div data-sla-target-editor class="hidden tw-mt-1 tw-rounded-lg tw-border tw-border-gray-200
                                             tw-bg-white tw-p-2 tw-shadow-sm">
            <div class="tw-flex tw-items-center tw-gap-1">
              <input type="number" min="0.01" step="any" value="<%= amount %>"
                     aria-label="<%= l(:field_sla_duration_value) %>" data-sla-target-value
                     class="tw-w-20 tw-rounded-lg tw-border tw-border-gray-300 tw-px-2 tw-py-1 tw-text-sm">
              <select aria-label="<%= l(:field_sla_duration_unit) %>" data-sla-target-unit
                      data-sla-select
                      class="tw-rounded-lg tw-border tw-border-gray-300 tw-bg-white tw-px-2 tw-py-1 tw-text-sm">
                <option value="hours" <%= 'selected' if unit == 'hours' %>><%= l(:label_sla_hours) %></option>
                <option value="days" <%= 'selected' if unit == 'days' %>><%= l(:label_sla_days) %></option>
              </select>
            </div>
            <label class="tw-mt-2 tw-flex tw-items-center tw-gap-2 tw-text-xs tw-text-gray-700">
              <input type="checkbox" data-sla-target-best-effort <%= 'checked' if best_effort %>>
              <%= l(:label_sla_best_effort) %>
            </label>
          </div>
          <span data-sla-target-status aria-live="polite" class="tw-mt-1 tw-block tw-text-xs"></span>
        </div>
      </td>
    <% end %>
  </tr>
<% end %>
