<%# Sidebar section navigation. Locals: project, sections (from sla_visible_sections), current. %>
<%# Real <a href> links carrying ?section=..., so the page still navigates (server-side, via %>
<%# sla_current_section) if JavaScript is unavailable; sla_policy_form.js intercepts the click %>
<%# and swaps panels in place instead. Active/inactive styling is the single `is-active` class %>
<%# (see partials/_settings_nav.css) so the JS never has to carry Tailwind class strings. %>
<%# %>
<%# `is-locked` works the same way, for the sections that go read-only while SLA tracking is off %>
<%# (SlaPoliciesHelper::LOCKABLE_SECTIONS). Locked entries stay clickable — the section is readable, %>
<%# just not editable — and every lockable entry renders its padlock unconditionally, hidden by CSS %>
<%# until the class appears, so flipping the General switch has no markup for the JS to build. %>
<% locked = sla_tracking_off?(project) %>
<nav class="tw-w-full lg:tw-w-72 lg:tw-shrink-0" aria-label="<%= l(:label_sla_policy_settings) %>">
  <ul class="sla-section-nav tw-bg-white tw-border tw-border-gray-200 tw-rounded-lg tw-shadow-sm tw-overflow-hidden">
    <% sections.each do |section| %>
      <% key = section[:key] %>
      <% lockable = sla_lockable_section?(key) %>
      <li>
        <a href="<%= settings_project_path(project, tab: 'sla_policy', section: key) %>"
           class="sla-section-link<%= ' is-active' if key == current %><%= ' is-locked' if lockable && locked %>"
           data-sla-section-link="<%= key %>"
           <%# Always present, true or false, rather than an attribute that appears only on the %>
           <%# lockable rows: emitting an attribute conditionally inside an opening tag has no %>
           <%# clean expression in Rails 6.1 (`tag.attributes` is 7.0+, and method_missing turns %>
           <%# it into an `<attributes>` element that closes this tag early). The JS matches on %>
           <%# the value. %>
           data-sla-lockable="<%= lockable %>"
           aria-current="<%= key == current ? 'page' : 'false' %>">
          <span class="sla-section-link-icon"><%= sla_section_icon(key) %></span>
          <span class="tw-min-w-0 tw-flex-1">
            <span class="sla-section-link-title"><%= sla_section_label(key) %></span>
          </span>
          <% if lockable %>
            <span class="sla-section-link-lock" title="<%= l(:label_sla_section_locked_title) %>">
              <%= sla_lock_icon('') %>
            </span>
          <% end %>
          <svg class="sla-section-link-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>
      </li>
    <% end %>
  </ul>
</nav>
