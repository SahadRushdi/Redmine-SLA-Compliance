<%# Sidebar section navigation. Locals: project, sections (from sla_visible_sections), current. %>
<%# Real <a href> links carrying ?section=..., so the page still navigates (server-side, via %>
<%# sla_current_section) if JavaScript is unavailable; sla_policy_form.js intercepts the click %>
<%# and swaps panels in place instead. Active/inactive styling is the single `is-active` class %>
<%# (see partials/_settings_nav.css) so the JS never has to carry Tailwind class strings. %>
<nav class="tw-w-full lg:tw-w-72 lg:tw-shrink-0" aria-label="<%= l(:label_sla_policy_settings) %>">
  <ul class="sla-section-nav tw-bg-white tw-border tw-border-gray-200 tw-rounded-lg tw-shadow-sm tw-overflow-hidden">
    <% sections.each do |section| %>
      <% key = section[:key] %>
      <li>
        <a href="<%= settings_project_path(project, tab: 'sla_policy', section: key) %>"
           class="sla-section-link<%= ' is-active' if key == current %>"
           data-sla-section-link="<%= key %>"
           aria-current="<%= key == current ? 'page' : 'false' %>">
          <span class="sla-section-link-icon"><%= sla_section_icon(key) %></span>
          <span class="tw-min-w-0 tw-flex-1">
            <span class="sla-section-link-title"><%= sla_section_label(key) %></span>
            <span class="sla-section-link-desc"><%= sla_section_description(key) %></span>
          </span>
          <svg class="sla-section-link-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>
      </li>
    <% end %>
  </ul>
</nav>
