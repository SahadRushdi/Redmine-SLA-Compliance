<%# SLA on/off for a project that inherits its configuration (Global Rule 5). Changing this %>
<%# switch writes only a LIGHTWEIGHT policy row (SlaPolicy#inherits_config?), so coverage, targets %>
<%# and status mappings keep following the named ancestor. The separate Revert action removes %>
<%# that local decision and returns to following the ancestor's on/off state as well. %>
<%# Locals: project, source_project, state (:inherit/:enabled/:disabled), inherited_on (boolean). %>
<% enabled = state == :inherit ? inherited_on : state == :enabled %>

<div id="sla-enablement-form" data-tracking-url="<%= tracking_project_sla_policy_path(project) %>">
  <%= render layout: 'sla_policies/setting_card',
             locals: { title: l(:label_sla_enablement_card) } do %>
    <div class="tw-flex tw-items-center tw-gap-4">
      <span class="tw-text-sm tw-text-gray-500">
        <%= l(:label_sla_enablement_inherited_from, project: h(source_project.name)) %>
      </span>
      <%= render 'sla_compliance/toggle', name: 'sla_policy[enablement]', checked: enabled,
                 data: { sla_inherited_enablement: true } %>
    </div>
  <% end %>
</div>
