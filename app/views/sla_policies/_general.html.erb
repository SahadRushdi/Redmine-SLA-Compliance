<%# General section — SLA on/off and coverage hours (business calendar shown only for Business %>
<%# Hours coverage). Its own <form>: each section saves independently, and the hidden `section` %>
<%# field tells SlaPoliciesController#update which slice of the policy this submit may touch, so %>
<%# saving here can never clear another section's status mappings or targets. Locals: project, %>
<%# policy, current (active section key), inherited_source. %>
<%= render layout: 'sla_policies/panel', locals: { key: 'general', current: current } do %>

  <%# While the configuration is inherited, the on/off decision gets the TRI-STATE control rather %>
  <%# than the plain switch, and lives in its own form (section=enablement) — choosing Enabled or %>
  <%# Disabled there writes only that decision and keeps following the ancestor's configuration, %>
  <%# whereas anything saved through the form below forks it. Exactly one on/off control is on the %>
  <%# page either way; forms cannot nest, so this sits beside, not inside, the General form. %>
  <% if inherited_source.present? %>
    <%= render 'sla_policies/enablement', project: project, source_project: inherited_source.first,
               state: sla_enablement_state(project),
               inherited_on: sla_inherited_enablement_on?(project) %>
  <% end %>

  <%= form_tag project_sla_policy_path(project), method: :put, id: 'sla-general-form' do %>
    <%= hidden_field_tag 'tab', 'sla_policy' %>
    <%= hidden_field_tag 'section', 'general' %>

    <%# Both settings on this section are a single control apiece, so each is ONE row — name and
        helper line on the left, control on the right — rather than a titled card wrapping a
        field that restates the title. See sla_policies/_setting_card.html.erb. %>
    <% if inherited_source.blank? %>
      <%= render layout: 'sla_policies/setting_card',
                 locals: { title: l(:field_sla_tracking),
                           description: l(:text_sla_tracking_hint) } do %>
        <%= render 'sla_compliance/toggle', name: 'sla_policy[enabled]', checked: policy.enabled? %>
      <% end %>
    <% end %>

    <%= render layout: 'sla_policies/setting_card',
               locals: { title: l(:label_sla_coverage_card),
                         description: l(:text_sla_coverage_schedule_hint) } do %>
      <%# The row's own title is the label now, so the select carries its field name as an %>
      <%# aria-label instead of a visible <label> that would repeat it. %>
      <div class="tw-w-full md:tw-w-80">
        <%= select_tag 'sla_policy[coverage_hours]',
              options_for_select(SlaPolicy::COVERAGE_HOURS.map { |c| [l("label_coverage_#{c}"), c] },
                                 policy.coverage_hours),
              id: 'sla_policy_coverage_hours', class: sla_input_classes,
              'aria-label': l(:field_sla_coverage_schedule), data: { sla_select: true } %>

        <%# Dependent field: revealed by sla_policy_form.js only while Business Hours is selected, %>
        <%# so it stacks under the control it depends on rather than sitting in a card of its own. %>
        <div id="sla-calendar-field" class="tw-mt-3 <%= 'hidden' unless policy.business_hours? %>">
          <label for="sla_policy_business_calendar_id" class="<%= sla_label_classes %>"><%= l(:field_business_calendar) %></label>
          <% calendars = SlaBusinessCalendar.order(:name).to_a %>
          <% if calendars.any? %>
            <%= select_tag 'sla_policy[business_calendar_id]',
                  options_for_select([['', '']] + calendars.map { |c| [c.name, c.id] },
                                     policy.business_calendar_id),
                  id: 'sla_policy_business_calendar_id', class: sla_input_classes,
                  data: { sla_select: true } %>
          <% else %>
            <p class="tw-text-sm tw-text-gray-500"><%= l(:text_sla_no_business_calendars) %></p>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= render 'sla_policies/save_bar', label: l(:button_sla_save_general) %>
  <% end %>

  <%# B3 — "Revert to inherited policy": only offered when this project has its OWN row AND some %>
  <%# further ancestor also has one to fall back to (otherwise there'd be nothing to revert TO). %>
  <%# It lives here (a policy-lifecycle action, not a field) and OUTSIDE the form above, because %>
  <%# button_to emits its own form and forms cannot nest. %>
  <%# %>
  <%# Rendered as a settings row like everything else on this section — name, one-line consequence, %>
  <%# action on the right — rather than a bare button with a caption trailing under it, where it %>
  <%# read as loose text below the card stack rather than as an action belonging to this page. %>
  <% if policy.persisted? && project.parent.present? %>
    <% ancestor_project, = SlaPolicy.source_for(project.parent) %>
    <% if ancestor_project.present? %>
      <%= render layout: 'sla_policies/setting_card',
                 locals: { title: l(:button_sla_revert_to_inherited),
                           description: l(:text_sla_revert_hint, project: ancestor_project.name) } do %>
        <%# form_class strips button_to's default `button_to` class, which Purplemine2 styles; the %>
        <%# button carries the plugin's own primary classes instead. %>
        <%= button_to l(:button_sla_revert), project_sla_policy_path(project),
              method: :delete, form_class: '',
              data: { confirm: l(:text_sla_revert_confirm, project: ancestor_project.name) },
              class: sla_primary_button_classes %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
