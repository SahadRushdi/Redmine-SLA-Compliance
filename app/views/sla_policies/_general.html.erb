<%# Enable toggle, coverage hours, business calendar (shown only for Business Hours). %>
<div class="tw-bg-white tw-border tw-border-gray-200 tw-rounded-lg tw-shadow-sm tw-p-5 tw-mb-6">
  <h3 class="tw-text-base tw-font-semibold tw-text-gray-900 tw-mb-4"><%= l(:label_sla_policy_general) %></h3>

  <div class="tw-mb-4">
    <%= render 'sla_compliance/toggle', name: 'sla_policy[enabled]',
               checked: policy.enabled?, label: l(:field_sla_enabled) %>
  </div>

  <div class="tw-grid tw-grid-cols-1 md:tw-grid-cols-2 tw-gap-4">
    <div>
      <label for="sla_policy_coverage_hours" class="<%= sla_label_classes %>"><%= l(:field_coverage_hours) %></label>
      <%= select_tag 'sla_policy[coverage_hours]',
            options_for_select(SlaPolicy::COVERAGE_HOURS.map { |c| [l("label_coverage_#{c}"), c] },
                               policy.coverage_hours),
            id: 'sla_policy_coverage_hours', class: sla_input_classes, data: { sla_select: true } %>
    </div>

    <div id="sla-calendar-field" class="<%= 'hidden' unless policy.business_hours? %>">
      <label for="sla_policy_business_calendar_id" class="<%= sla_label_classes %>"><%= l(:field_business_calendar) %></label>
      <% calendars = SlaBusinessCalendar.order(:name).to_a %>
      <% if calendars.any? %>
        <%= select_tag 'sla_policy[business_calendar_id]',
              options_for_select([['', '']] + calendars.map { |c| [c.name, c.id] },
                                 policy.business_calendar_id),
              id: 'sla_policy_business_calendar_id', class: sla_input_classes,
              data: { sla_select: true } %>
      <% else %>
        <p class="tw-text-sm tw-text-gray-500"><%= l(:text_sla_no_business_calendars) %></p>
      <% end %>
    </div>
  </div>
</div>
