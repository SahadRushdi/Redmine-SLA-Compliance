<%# One-line notice above the (fully populated, fully editable) policy sections, telling the user %>
<%# where the values they are looking at come from and what saving will do. It replaces the former %>
<%# read-only "Inherited Policy Summary" — the sections below now show every one of those fields %>
<%# as a real control, so repeating them above was the same data twice. %>
<%# %>
<%# No "Override for this project" button either: the form IS the override, taken the moment a %>
<%# section is saved. Locals: project, source_project. %>
<div class="tw-flex tw-items-start tw-gap-3 tw-mb-5 tw-p-4 tw-rounded-lg tw-border
            tw-border-blue-200 tw-bg-blue-50 tw-text-sm tw-text-blue-900">
  <span class="tw-mt-0.5 tw-text-primary-600"><%= sla_info_icon %></span>
  <div class="tw-min-w-0">
    <p class="tw-m-0"><%= l(:text_sla_inherited_notice, project: h(source_project.name)) %></p>
    <% if User.current.allowed_to?(:edit_sla_policy, source_project) %>
      <p class="tw-mt-1 tw-mb-0">
        <%= link_to l(:button_sla_view_source_policy),
              settings_project_path(source_project, tab: 'sla_policy'),
              class: 'tw-font-medium tw-underline' %>
      </p>
    <% end %>
  </div>
</div>
