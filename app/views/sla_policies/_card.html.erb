<%# Section card: tinted header over a white body. Used as a %>
<%# LAYOUT partial so every section builds its cards the same way and none re-types the chrome — %>
<%# render it with `render layout: "sla_policies/card", locals: { title: }` and a block holding %>
<%# the card body. %>
<%# %>
<%# Optional locals for the case where the card and ONE control are the same idea: %>
<%#   control     — markup placed on the HEADER row, beside the title. The heading and its %>
<%#                 title is then that control's label. Pass a rendered partial, e.g. %>
<%#                 render('sla_compliance/toggle', …). %>
<%#   header_note — optional status markup below the title which remains visible when a revealed %>
<%#                 body is collapsed (used for notification fallback provenance). %>
<%#   body_reveal — data-sla-reveal key for the BODY, so a switch passed as `control` collapses the %>
<%#                 whole body, padding included, rather than leaving an empty white strip below %>
<%#                 itself. body_hidden renders it already collapsed to match the switch's state. %>
<%# %>
<%# Deliberately NOT tw-overflow-hidden: a Tom Select dropdown is absolutely positioned inside the %>
<%# card body, so clipping the card turned every dropdown near the bottom into an inner scroll %>
<%# area instead of letting the list open over the card. The header rounds its own top corners %>
<%# instead, which is all the clipping was ever doing. %>
<div class="tw-bg-white tw-border tw-border-gray-200 tw-rounded-lg tw-shadow-sm tw-mb-5">
  <%# tw-m-0 / tw-mb-0: Preflight is disabled, so Purplemine2's own h3 and p margins are still in %>
  <%# force and would otherwise pad the header out of proportion. %>
  <%# tw-items-center: a header control sits on the title's optical centre; it wraps to stacked at %>
  <%# narrow widths, where title-beside-control has no room to be a row at all. %>
  <div class="tw-bg-gray-50 tw-border-b tw-border-gray-200 tw-rounded-t-lg tw-px-5 tw-py-4
              tw-flex tw-flex-wrap tw-items-center tw-justify-between tw-gap-x-6 tw-gap-y-3">
    <div class="tw-min-w-0 tw-flex-1">
      <h3 class="tw-m-0 tw-text-base tw-font-semibold tw-text-gray-900"><%= title %></h3>
      <%= local_assigns[:header_note] if local_assigns[:header_note].present? %>
    </div>
    <% if local_assigns[:control].present? %>
      <div class="tw-shrink-0"><%= control %></div>
    <% end %>
  </div>
  <%# content_tag, not a hand-written <div> with an interpolated attribute: the reveal key is %>
  <%# optional, and `tag.attributes` — the obvious way to emit an attribute conditionally — does %>
  <%# NOT exist in Rails 6.1 (this plugin's version; it arrived in 7.0). TagBuilder#method_missing %>
  <%# silently accepts it and builds an `<attributes …>` ELEMENT instead, which lands inside the %>
  <%# opening tag and closes it early — the rest of the real tag then renders as visible text. %>
  <% body_attrs = { class: "tw-p-5#{' hidden' if local_assigns[:body_hidden]}" } %>
  <% body_attrs[:data] = { sla_reveal: local_assigns[:body_reveal] } if local_assigns[:body_reveal] %>
  <%= content_tag :div, capture { yield }, body_attrs %>
</div>
