<%# B3 — this project has no SLA policy of its own; it inherits one from an ancestor. %>
<%# Deliberately NOT the interactive form partial: this is plain read-only markup with no %>
<%# <form>/inputs at all, so there is no way for this view to ever submit a change — the bug %>
<%# being fixed here was exactly a blank EDITABLE form silently creating a disabling override. %>
<%# "Override" re-uses the existing Clone-from-another-project AJAX flow (edit.js.erb / %>
<%# build_clone_prefill) with the ancestor as the source, so unlocking edit mode reaches %>
<%# code that's already tested via the Clone feature. Locals: project, source_project, source_policy. %>
<div class="tw-bg-blue-50 tw-border tw-border-blue-200 tw-rounded-lg tw-p-4 tw-mb-6">
  <p class="tw-text-sm tw-text-blue-900">
    <%= l(:text_sla_inherited_banner, project: h(source_project.name)) %>
  </p>
  <div class="tw-mt-3 tw-flex tw-flex-wrap tw-gap-3">
    <button type="button" id="sla-override-load" data-ancestor-id="<%= source_project.id %>"
            data-edit-url="<%= edit_project_sla_policy_path(project) %>"
            data-confirm-override="<%= l(:text_sla_override_confirm, project: source_project.name) %>"
            class="tw-text-white tw-bg-primary-600 hover:tw-bg-primary-700 focus:tw-ring-2
                   focus:tw-ring-primary-300 tw-font-medium tw-rounded-lg tw-text-sm
                   tw-px-4 tw-py-2 tw-cursor-pointer">
      <%= l(:button_sla_override) %>
    </button>
    <% if User.current.allowed_to?(:edit_sla_policy, source_project) %>
      <%= link_to l(:button_sla_view_source_policy),
            settings_project_path(source_project, tab: 'sla_policy'),
            class: 'tw-text-gray-700 tw-bg-white tw-border tw-border-gray-300 hover:tw-bg-gray-100 ' \
                   'tw-font-medium tw-rounded-lg tw-text-sm tw-px-4 tw-py-2 tw-inline-flex tw-items-center' %>
    <% end %>
  </div>
</div>

<%# Tri-state SLA on/off. Only the on/off decision is editable here — the configuration below stays %>
<%# read-only, since it belongs to source_project. Gated on :edit_sla_policy: the banner itself is %>
<%# also reachable by a notifications-only manager, who must not be able to switch SLA off. %>
<% if User.current.allowed_to?(:edit_sla_policy, project) %>
  <%= render 'sla_policies/enablement', project: project, source_project: source_project,
             state: sla_enablement_state(project),
             inherited_on: sla_inherited_enablement_on?(project) %>
<% end %>

<div class="tw-bg-white tw-border tw-border-gray-200 tw-rounded-lg tw-shadow-sm tw-p-5 tw-mb-6">
  <h3 class="tw-text-base tw-font-semibold tw-text-gray-900 tw-mb-4"><%= l(:label_sla_inherited_summary) %></h3>
  <dl class="tw-grid tw-grid-cols-1 md:tw-grid-cols-2 tw-gap-4 tw-text-sm">
    <div>
      <%# The EFFECTIVE state for THIS project, not source_policy.enabled? — a lightweight row here %>
      <%# can have switched SLA on or off independently of the ancestor whose config is shown below. %>
      <dt class="tw-font-medium tw-text-gray-500"><%= l(:field_sla_enabled) %></dt>
      <dd class="tw-text-gray-900">
        <%= SlaPolicy.effective_for(project).present? ? l(:general_text_Yes) : l(:general_text_No) %>
      </dd>
    </div>
    <div>
      <dt class="tw-font-medium tw-text-gray-500"><%= l(:field_coverage_hours) %></dt>
      <dd class="tw-text-gray-900">
        <%= source_policy.business_hours? ? l(:label_coverage_business_hours) : l(:label_coverage_24x7) %>
        <% if source_policy.business_hours? && source_policy.business_calendar %>
          (<%= h source_policy.business_calendar.name %>)
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="tw-font-medium tw-text-gray-500"><%= l(:field_sla_created_statuses) %></dt>
      <dd class="tw-text-gray-900"><%= sla_status_names(source_policy, :created) %></dd>
    </div>
    <div>
      <dt class="tw-font-medium tw-text-gray-500"><%= l(:field_sla_work_started_statuses) %></dt>
      <dd class="tw-text-gray-900"><%= sla_status_names(source_policy, :work_started) %></dd>
    </div>
    <div>
      <dt class="tw-font-medium tw-text-gray-500"><%= l(:field_sla_resolved_statuses) %></dt>
      <dd class="tw-text-gray-900"><%= sla_status_names(source_policy, :resolved) %></dd>
    </div>
    <div>
      <dt class="tw-font-medium tw-text-gray-500"><%= l(:field_first_response_rule) %></dt>
      <dd class="tw-text-gray-900"><%= l("label_first_response_#{source_policy.first_response_rule}") %></dd>
    </div>
    <div>
      <dt class="tw-font-medium tw-text-gray-500"><%= l(:field_at_risk_threshold) %></dt>
      <dd class="tw-text-gray-900"><%= source_policy.at_risk_threshold %>%</dd>
    </div>
    <div>
      <dt class="tw-font-medium tw-text-gray-500"><%= l(:field_sla_pause_statuses) %></dt>
      <dd class="tw-text-gray-900">
        <%= source_policy.pause_enabled? ? sla_status_names(source_policy, :pause) : l(:general_text_No) %>
      </dd>
    </div>
  </dl>

  <% project.trackers.each do |tracker| %>
    <% lines = sla_target_summary_lines(source_policy, tracker) %>
    <% next if lines.empty? %>
    <div class="tw-mt-4 tw-pt-4 tw-border-t tw-border-gray-100">
      <h4 class="tw-text-sm tw-font-semibold tw-text-gray-900 tw-mb-2"><%= h tracker.name %></h4>
      <ul class="tw-text-sm tw-text-gray-700 tw-list-disc tw-list-inside tw-space-y-1">
        <% lines.each do |line| %><li><%= line %></li><% end %>
      </ul>
    </div>
  <% end %>
</div>
