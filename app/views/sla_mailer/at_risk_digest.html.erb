<h1><%= l(:mail_heading_sla_at_risk_digest, project: @project.name) %></h1>
<table>
  <thead><tr><th><%= l(:label_issue) %></th><th><%= l(:label_sla_email_target) %></th><th><%= l(:field_status) %></th><th><%= l(:field_assigned_to) %></th><th><%= l(:label_sla_email_projected_breach) %></th></tr></thead>
  <tbody>
  <% @logs.each do |log|; issue = @issues[log.issue_id]; next unless issue %>
    <tr><td><%= link_to "##{issue.id}: #{issue.subject}", issue_url(issue, ::Mailer.default_url_options) %></td><td><%= l("label_sla_target_#{log.target}") %></td><td><%= issue.status %></td><td><%= issue.assigned_to || '—' %></td><td><%= format_time(@results[issue.id]&.breach_at) %></td></tr>
  <% end %>
  </tbody>
</table>
