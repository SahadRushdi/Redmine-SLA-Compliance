<%# A lookup table in a card. LAYOUT partial — render it with %>
<%# `render layout: 'sla_admin/data_table', locals: { headers: [...] }` and a block holding the %>
<%# <tr> rows; the card, scroll container, <table>, <thead> and <tbody> are supplied here so the %>
<%# module's tables cannot drift apart. %>
<%# %>
<%# Locals: headers — an array of column header strings. Pass '' for the trailing row-actions %>
<%# column, which has no name. %>
<%# %>
<%# The scroll container is on the table, not the card: a narrow window scrolls the columns %>
<%# sideways instead of the page. tw-overflow-hidden on the card would clip the sticky header %>
<%# rounding, so the corners are rounded on the inner wrapper instead. %>
<div class="tw-bg-white tw-border tw-border-solid tw-border-gray-200 tw-rounded-lg tw-shadow-sm">
  <div class="tw-overflow-x-auto tw-rounded-lg">
    <table class="<%= sla_admin_table_classes %>">
      <thead class="tw-bg-gray-50 tw-border-b tw-border-solid tw-border-gray-200">
        <tr>
          <%# Title case, never uppercase (CLAUDE.md) — the i18n value already carries the casing, %>
          <%# and no text-transform is applied here. %>
          <% headers.each do |header| %>
            <th scope="col" class="<%= sla_admin_th_classes %>"><%= header %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="sla-admin-rows"><%= yield %></tbody>
    </table>
  </div>
</div>
