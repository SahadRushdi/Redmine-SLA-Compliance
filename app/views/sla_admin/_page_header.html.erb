<%# Section heading with its one-line explanation and, optionally, the section's primary action %>
<%# pushed to the right (the "New …" button above a lookup table). %>
<%# Locals: title, description; action_label + action_path optional (both or neither). %>
<div class="tw-flex tw-flex-wrap tw-items-start tw-justify-between tw-gap-4 tw-mb-4">
  <div class="tw-min-w-0">
    <%# tw-m-0 / tw-mb-0 — Preflight is disabled, so the theme's own h3/p margins still apply. %>
    <h3 class="tw-m-0 tw-text-lg tw-font-semibold tw-text-gray-900"><%= title %></h3>
    <p class="tw-mt-1 tw-mb-0 tw-text-sm tw-text-gray-500"><%= description %></p>
  </div>
  <% if local_assigns[:action_label].present? && local_assigns[:action_path].present? %>
    <%= link_to action_path, class: "#{sla_primary_button_classes} tw-no-underline tw-shrink-0" do %>
      <%= sla_add_icon %><span><%= action_label %></span>
    <% end %>
  <% end %>
</div>
