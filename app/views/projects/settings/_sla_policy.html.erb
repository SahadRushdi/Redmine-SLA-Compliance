<%# SLA Policy tab shell. Rendered inline by ProjectsController#settings; the tab %>
<%# itself is injected by RedmineSlaCompliance::Patches::ProjectsHelperPatch. Each section is %>
<%# gated by its own permission. All markup lives inside .sla-plugin (scoped Tailwind). %>
<%# %>
<%# Layout: a sidebar of sections beside a column of panels, instead of one long scrolling page. %>
<%# Which sections exist, and which one opens, is decided by SlaPoliciesHelper (permission- and %>
<%# inheritance-aware) so the nav and the panels can never disagree. %>
<%# %>
<%# The panel column holds two independently-replaceable regions: #sla-policy-tab-body (the policy %>
<%# sections) and #sla-policy-notifications-slot. Both are swapped by a clone load — a clone copies %>
<%# the notification setup too, so it has to be shown — while every other re-render touches only %>
<%# the first, leaving unsaved notification input alone. %>
<%= render 'sla_compliance/assets' %>
<% content_for :header_tags do %>
  <%= javascript_include_tag 'sla_policy_form.js', plugin: 'redmine_sla_compliance' %>
<% end %>

<% inherited_source = sla_inherited_policy_source(@project) %>
<% sections = sla_visible_sections(@project) %>
<% current = sla_current_section(sections) %>

<div class="sla-plugin">
  <div class="tw-mb-6">
    <h2 class="tw-m-0 tw-text-xl tw-font-semibold tw-text-gray-900"><%= l(:label_sla_policy_settings) %></h2>
  </div>

  <div id="sla-policy-settings" class="tw-flex tw-flex-col lg:tw-flex-row tw-gap-6 tw-items-start">
    <%= render 'sla_policies/nav_slot', project: @project, sections: sections, current: current %>

    <%# Deliberately NOT given the reference design's gray-50 page canvas. It would read well behind %>
    <%# the General section's new headerless white cards, but sla_policies/_card.html.erb — used by %>
    <%# every section this change was told to leave alone — separates its header from its body with %>
    <%# a gray-50 tint, and on a gray-50 canvas that header stops looking like part of the card at %>
    <%# all. Matching the reference here means whitening those headers too, which is a change to %>
    <%# sections that were explicitly out of scope. %>
    <div class="tw-flex-1 tw-min-w-0 tw-w-full">
      <div id="sla-policy-tab-body">
        <%= render 'sla_policies/policy_body',
                   project: @project, policy: sla_policy_for_form(@project),
                   current: current, inherited_source: inherited_source %>
      </div>

      <%= render 'sla_policies/notifications_slot', project: @project, current: current %>
    </div>
  </div>
</div>
