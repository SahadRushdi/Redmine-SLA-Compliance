<%# Step 6.1 — filter bar. Plain GET form + full-page resubmit (matches Redmine's own report/ %>
<%# filter pages). Tracker/Priority option lists are already narrowed server-side %>
<%# (SlaDashboardController#resolve_filters) to what's actually configured for the currently %>
<%# selected project(s)/tracker. %>
<%#
  Auto-apply, no Apply/Clear buttons (per the time_analytics plugin's own auto-apply
  convention): every control submits the form itself on change
  (assets/javascripts/sla_dashboard_filters.js). Date Range pills and the single-value Tracker
  dropdown submit immediately; the Project/Priority multi-selects and the custom date inputs
  debounce briefly so picking several chips or filling both date fields doesn't navigate away
  mid-selection. Individual active filters are still removable via the chip row's "×" below.

  Date Range renders as a Figma-style segmented pill group layered over the real
  `#sla-filter-date-preset` <select> — kept in the DOM (visually hidden) so it still submits
  normally and every existing functional-test assertion on it (option[selected], clamped values,
  etc.) keeps working unmodified.

  Every control lives on the single header row: the title sits on the left, and Project/Tracker/
  Priority/Export CSV sit on the right of that SAME row, opposite the heading. The row's own
  tw-flex handles that, so the <form> needs no `tw-contents` — it has exactly one child.
%>
<div class="tw-mb-6">
  <%= form_tag(sla_dashboard_base_path(@project), method: :get, id: 'sla-filter-form') do %>
    <%# tw-items-center, not tw-items-start: with the subtitle banner gone the title is a single %>
    <%# line and sits on the same baseline band as the filter controls opposite it. %>
    <div class="tw-flex tw-items-center tw-justify-between tw-flex-wrap tw-gap-4">
      <%# No subtitle here. "Open Tickets is live / SLA Trend is date-scoped" was a permanent %>
      <%# boxed sentence restating what the two tab labels and their Live / Date-scoped badges %>
      <%# already say — the badges carry it now. %>
      <%# tw-text-xl, matching the SLA Policy Settings page's own h2 — the two are the same kind of %>
      <%# thing (a plugin page title under Redmine's own chrome) and had no reason to differ. %>
      <h1 class="tw-text-xl tw-font-bold tw-text-gray-900">
        <%= @project ? "#{l(:label_sla_compliance)} - #{@project.name}" : l(:label_sla_dashboard_all) %>
      </h1>

      <%# Clean single-line header (Figma): no stacked field labels — the Date Range pills, the %>
      <%# Tracker/Priority dropdowns, and Export CSV sit centered on one baseline. Labels are %>
      <%# preserved for screen readers via aria-label on each control/group. %>
      <div class="tw-flex tw-flex-wrap tw-items-center tw-gap-3">
        <%# Date Range controls moved to the SLA Trend tab (_trend_panel.html.erb) — they scope only %>
        <%# that tab. Project/Tracker/Priority scope BOTH tabs, so they stay here. %>

        <%# Project sits inline with Tracker/Priority rather than in its own card row below: with a %>
        <%# single permitted project (the common project-level case) that card was an almost-empty %>
        <%# full-width band. Same chip control family as the other two, so it reads as one filter %>
        <%# group. The locked-project explanation moves from a caption to the wrapper's title %>
        <%# tooltip — there is no room for a caption on a single-line header. %>
        <div class="tw-min-w-[12rem]"
             <% if @locked_project %>title="<%= l(:text_sla_filter_locked_project_hint) %>"<% end %>>
          <%= select_tag 'project_ids[]',
                options_for_select(@permitted_projects.map { |p| [p.name, p.id] }, @filters[:project_ids]),
                id: 'sla-filter-projects', multiple: true, disabled: @locked_project,
                class: sla_input_classes, placeholder: l(:label_sla_filter_all_projects),
                'aria-label': l(:label_sla_filter_project),
                data: { 'sla-chips': true, 'sla-auto-apply-debounced': true } %>
        </div>

        <%# Tracker is a multi-select (chips), same control family as Priority — an empty selection %>
        <%# means "all trackers". Priority stays disabled until at least one tracker is chosen, since %>
        <%# its option list is the union of the selected trackers' configured priorities. %>
        <div class="tw-min-w-[12rem]">
          <%= select_tag 'tracker_ids[]',
                options_for_select(@available_trackers.map { |t| [t.name, t.id] }, @filters[:tracker_ids]),
                id: 'sla-filter-tracker', multiple: true, class: sla_input_classes,
                placeholder: l(:label_sla_filter_all_trackers), 'aria-label': l(:label_sla_filter_tracker),
                data: { 'sla-chips': true, 'sla-auto-apply-debounced': true } %>
        </div>

        <div class="tw-min-w-[12rem]">
          <%= select_tag 'priority_ids[]',
                options_for_select(@available_priorities.map { |p| [p.name, p.id] }, @filters[:priority_ids]),
                id: 'sla-filter-priorities', multiple: true, disabled: @filters[:tracker_ids].blank?,
                class: sla_input_classes, placeholder: l(:label_sla_filter_all_priorities),
                'aria-label': l(:label_sla_filter_priority),
                data: { 'sla-chips': true, 'sla-auto-apply-debounced': true } %>
        </div>

        <%= link_to sla_detail_table_url(@filters, @project, format: 'csv'),
              class: 'tw-inline-flex tw-items-center tw-gap-2 tw-text-white tw-bg-primary-600 hover:tw-bg-primary-700 tw-font-medium ' \
                     'tw-rounded-lg tw-text-sm tw-px-4 tw-py-2.5 tw-shadow-sm focus:tw-outline-none focus:tw-ring-4 focus:tw-ring-primary-200' do %>
          <svg class="tw-w-4 tw-h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3" />
          </svg>
          <%= l(:button_sla_export_csv) %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
