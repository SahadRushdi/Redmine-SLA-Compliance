<%# SLA Met card for the selected Trend period. The cohort is based on cycle_started_at, the SLA %>
<%# engine's cached Created/reopen milestone timestamp, and includes both open and resolved evaluated %>
<%# tickets. At-risk remains a subset of met and No-SLA is excluded by Sla::DashboardScope. %>
<%# %>
<%# Same _summary_card anatomy as the Open Tickets tab's row (icon tile, label, big number, muted %>
<%# caption) so the two tabs share one card design and one type scale. The surface is overridden to %>
<%# white: this card stands alone beside the chart rather than in a row of five, where the tinted %>
<%# fills exist to tell the five states apart at a glance. %>
<%= render 'sla_dashboard/summary_card',
      state: :met, label: sla_card_label(:met_window),
      surface: 'tw-bg-white tw-border-gray-200',
      value: safe_join([
        content_tag(:span, sla_percentage(@trend_counts.met, @trend_counts.total), id: 'sla-met-window-percentage'),
        '%',
        content_tag(:span, safe_join(['(', content_tag(:span, @trend_counts.met, id: 'sla-met-window-value'), ')']),
                    class: 'tw-text-xl tw-font-semibold tw-opacity-80 tw-ml-1')
      ]),
      caption: l(:text_sla_met_in_target, met: @trend_counts.met, total: @trend_counts.total),
      caption_id: 'sla-met-window-caption' %>
