<%# SLA Met card for the selected Trend period. It reads the same evaluated cohort as Trend Detail: %>
<%# unresolved cycles started in the window plus outcomes resolved in it. No-SLA is excluded by %>
<%# Sla::DashboardScope, and ResultSummary supplies each row's current effective state. %>
<%# %>
<%# Same _summary_card anatomy as the Open Tickets tab's row (icon tile, label, big number, muted %>
<%# caption) so the two tabs share one card design and one type scale. The surface is overridden to %>
<%# white: this card stands alone beside the chart rather than in a row of five, where the tinted %>
<%# fills exist to tell the five states apart at a glance. %>
<%= render 'sla_dashboard/summary_card',
      state: :met, label: sla_card_label(:met_window),
      surface: 'tw-bg-white tw-border-gray-200',
      centered: true,
      value: safe_join([
        content_tag(:span, sla_percentage(@trend_detail_counts.met, @trend_detail_counts.total), id: 'sla-met-window-percentage'),
        '%',
        content_tag(:span, safe_join(['(', content_tag(:span, @trend_detail_counts.met, id: 'sla-met-window-value'), ')']),
                    class: 'tw-text-xl tw-font-semibold tw-opacity-80 tw-ml-1')
      ]),
      caption: l(:text_sla_met_in_target, count: @trend_detail_counts.total,
                 met: @trend_detail_counts.met, total: @trend_detail_counts.total),
      caption_id: 'sla-met-window-caption' %>
