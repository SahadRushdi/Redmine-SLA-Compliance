<%# Step 6.3 — Created vs Resolved trend (dual line, Daily/Weekly/Monthly). Colors are hand-picked: %>
<%# Created reuses the breached red (incoming/backlog) and Resolved the met green (cleared), so the %>
<%# two lines read at a glance and stay visually consistent with the rest of the plugin's palette. %>
<%# sla_dashboard_charts.js reads these per-dataset colors and draws larger points so each data %>
<%# point is clearly visible. pointBorderColor is pinned to white here (as well as in the JS %>
<%# elements.point defaults) so no globally-registered Chart.js plugin can ever fill it in — that %>
<%# is exactly how the blue rings around every point got there before. %>
<% trend_payload = {
     labels: @trend_series.map(&:bucket_label),
     datasets: [
       { label: l(:label_sla_created), data: @trend_series.map(&:created),
         borderColor: sla_chart_color(:breached), backgroundColor: sla_chart_color(:breached),
         pointBackgroundColor: sla_chart_color(:breached), pointBorderColor: '#ffffff' },
       { label: l(:label_sla_resolved), data: @trend_series.map(&:resolved),
         borderColor: sla_chart_color(:met), backgroundColor: sla_chart_color(:met),
         pointBackgroundColor: sla_chart_color(:met), pointBorderColor: '#ffffff' }
     ]
   } %>
<div class="tw-flex tw-flex-col">
  <div class="tw-flex tw-items-center tw-justify-between tw-flex-wrap tw-gap-3 tw-mb-3">
    <h3 class="tw-text-base tw-font-semibold tw-text-gray-900"><%= l(:label_sla_chart_trend) %></h3>

    <div class="tw-flex tw-items-center tw-gap-4 tw-flex-wrap">
      <%# ERB-rendered legend (Chart.js's own native legend/onClick is disabled in %>
      <%# sla_dashboard_charts.js) - same data-sla-legend-target/-dataset click pattern the %>
      <%# priority chart's legend uses, for the same click-to-highlight-not-hide behavior. The %>
      <%# swatch colors are painted by sla_dashboard_charts.js (populateLegendSwatches) from the %>
      <%# chart's own baseColors rather than inlined here, so the legend dot and the line it stands %>
      <%# for can never drift apart. %>
      <% unless @trend_series.empty? %>
        <div id="sla-trend-chart-legend" class="tw-flex tw-items-center tw-gap-x-4 tw-text-xs tw-text-gray-600">
          <% [[l(:label_sla_created), 0], [l(:label_sla_resolved), 1]].each do |label, index| %>
            <span class="sla-legend-item tw-inline-flex tw-items-center tw-gap-1.5"
                  data-sla-legend-target="sla-trend-chart" data-sla-legend-dataset="<%= index %>">
              <span class="sla-legend-swatch tw-w-2.5 tw-h-2.5 tw-rounded-full tw-inline-block"></span>
              <%= label %>
            </span>
          <% end %>
        </div>
      <% end %>

      <%# Same segmented-pill-over-a-hidden-<select> pattern as the Date Range pills in %>
      <%# _filter_bar.html.erb, but this partial renders outside that partial's own <form> element %>
      <%# (it's included from _charts.html.erb, a sibling of _filter_bar.html.erb under %>
      <%# sla_dashboard/index.html.erb) — the hidden select carries `form="sla-filter-form"` so it %>
      <%# still participates in that form's submission, and the click handler in %>
      <%# sla_dashboard_filters.js targets #sla-filter-form directly rather than via `closest('form')`. %>
      <%# Segmented control on a gray-100 track — the same active/inactive language as the page's %>
      <%# Open Tickets / SLA Trend tabs, so "pick one of these" looks the same everywhere on the %>
      <%# dashboard. tw-shadow-none: Purplemine2's global `button{}` rule sets a permanent blue 1px %>
      <%# box-shadow line under every button — see the matching note in _filter_bar.html.erb. %>
      <div class="tw-inline-flex tw-gap-1 tw-p-1 tw-bg-gray-100 tw-rounded-lg" role="group" aria-label="<%= l(:label_sla_filter_granularity) %>">
        <% sla_granularities.each do |granularity| %>
          <% active = @filters[:granularity] == granularity %>
          <button type="button" data-sla-granularity-btn="<%= granularity %>"
                  class="tw-px-3 tw-py-1 tw-rounded-md tw-text-xs tw-font-semibold tw-border-0 tw-transition-colors focus:tw-outline-none focus:tw-ring-2 focus:tw-ring-primary-300
                         <%= active ? 'tw-bg-primary-600 tw-text-white tw-shadow-sm' : 'tw-bg-transparent hover:tw-bg-transparent tw-text-gray-600 hover:tw-text-gray-900 tw-shadow-none' %>">
            <%= sla_granularity_label(granularity) %>
          </button>
        <% end %>
      </div>
      <%= select_tag 'granularity',
            options_for_select(sla_granularities.map { |g| [sla_granularity_label(g), g] }, @filters[:granularity]),
            id: 'sla-filter-granularity', form: 'sla-filter-form', class: 'tw-hidden' %>
    </div>
  </div>

  <div class="tw-relative tw-w-full" style="height: 18rem;">
    <% if @trend_series.empty? %>
      <p class="tw-text-sm tw-text-gray-400 tw-py-8 tw-text-center"><%= l(:text_sla_detail_table_empty_state) %></p>
    <% else %>
      <canvas id="sla-trend-chart" data-chart="<%= trend_payload.to_json %>"></canvas>
    <% end %>
  </div>
</div>
