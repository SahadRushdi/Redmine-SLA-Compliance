<%# SLA Trend tab. Its SLA Met cohort and Created-vs-Resolved series use this date range. %>
<%# The Date Range pills + custom-range %>
<%# inputs were moved here from the header filter bar; they sit OUTSIDE #sla-filter-form's DOM %>
<%# subtree, so each carries form="sla-filter-form" (HTML5 form association) to still submit as %>
<%# part of that one filter form — the same pattern the granularity pills already use. %>
<%# The date controls lead this tab from the LEFT edge, directly under the tabs, because they are %>
<%# the chart's primary control — not a trailing accessory to a sentence. The sentence that used to %>
<%# run alongside them ("Tickets within the selected window — the only view this date range %>
<%# affects.") is gone: only this tab renders these buttons, so their presence already says which %>
<%# chart they scope. What is left beside them is the one fact the buttons don't state — the actual %>
<%# date window they resolve to — as subdued text, with the full explanation on hover. %>
<div class="tw-flex tw-items-center tw-flex-wrap tw-gap-x-3 tw-gap-y-2 tw-mb-6">
  <div class="tw-flex tw-flex-wrap tw-items-center tw-gap-2" role="group" aria-label="<%= l(:label_sla_filter_date_range) %>">
    <% sla_date_presets.each do |preset| %>
      <%# Separately rounded buttons rather than one joined segmented bar: at six presets the joined %>
      <%# bar could not wrap without breaking its own rounded ends. %>
      <%# %>
      <%# `.sla-pill` + a single `is-active` class, NOT a ternary over Tailwind utilities: %>
      <%# sla_dashboard_filters.js repaints the clicked pill before the page reloads, and the two %>
      <%# class lists have to be the same list. See partials/_pill_group.css for the whole story %>
      <%# (including why these carry no focus-ring utilities). %>
      <button type="button" data-sla-preset-btn="<%= preset %>"
              class="sla-pill<%= ' is-active' if @filters[:date_preset] == preset %>">
        <%= sla_date_preset_label(preset) %>
      </button>
    <% end %>
  </div>
  <%= select_tag 'date_preset',
        options_for_select(sla_date_presets.map { |p| [sla_date_preset_label(p), p] }, @filters[:date_preset]),
        id: 'sla-filter-date-preset', form: 'sla-filter-form', class: 'tw-hidden' %>

  <span class="tw-text-sm tw-text-gray-400" title="<%= l(:text_sla_trend_window_hint) %>">
    <%= sla_dashboard_date_range_label(@filters[:date_range]) %>
  </span>

  <%# One LINKED range picker across both inputs (tints the days between From and To). The library %>
  <%# finds its two inputs via querySelectorAll('input') in DOM order, so From must stay first. %>
  <div id="sla-custom-range" data-sla-daterangepicker
       class="tw-flex tw-gap-2 <%= 'hidden' unless @filters[:date_preset] == 'custom' %>">
    <div>
      <%= text_field_tag 'from', @filters[:date_range]&.first&.strftime('%m/%d/%Y'), id: 'sla-filter-from',
            class: sla_input_classes, autocomplete: 'off', form: 'sla-filter-form',
            placeholder: l(:field_sla_date_from), 'aria-label': l(:field_sla_date_from) %>
    </div>
    <div>
      <%= text_field_tag 'to', @filters[:date_range]&.last&.strftime('%m/%d/%Y'), id: 'sla-filter-to',
            class: sla_input_classes, autocomplete: 'off', form: 'sla-filter-form',
            placeholder: l(:field_sla_date_to), 'aria-label': l(:field_sla_date_to) %>
    </div>
  </div>
</div>

<div class="tw-grid tw-grid-cols-1 lg:tw-grid-cols-12 tw-gap-6 tw-mb-6 tw-items-stretch">
  <div class="lg:tw-col-span-2 tw-flex">
    <%= render 'sla_dashboard/sla_met_card' %>
  </div>
  <div data-sla-trend-card
       class="lg:tw-col-span-10 tw-bg-white tw-border tw-border-gray-200 tw-rounded-xl tw-shadow-sm tw-p-5 tw-min-h-[24rem] tw-flex tw-flex-col tw-min-w-0">
    <div class="tw-flex tw-items-center tw-justify-between tw-flex-wrap tw-gap-3 tw-pb-3 tw-mb-4 tw-border-b tw-border-gray-200">
      <div class="tw-inline-flex tw-items-center tw-gap-2" role="tablist" aria-label="<%= l(:label_sla_tab_sla_trend) %>">
        <button type="button" data-sla-trend-card-tab="chart" role="tab" aria-selected="true"
                aria-controls="sla-trend-card-chart"
                class="sla-trend-card-tab tw-px-4 tw-py-2 tw-rounded-lg tw-border-0 tw-text-sm tw-font-semibold tw-shadow-none focus:tw-outline-none focus:tw-ring-2 focus:tw-ring-primary-200 tw-bg-primary-600 tw-text-white">
          <%= l(:label_sla_trend_card_tab_trend) %>
        </button>
        <button type="button" data-sla-trend-card-tab="detail" role="tab" aria-selected="false"
                aria-controls="sla-trend-card-detail"
                class="sla-trend-card-tab tw-px-4 tw-py-2 tw-rounded-lg tw-border-0 tw-text-sm tw-font-semibold tw-shadow-none focus:tw-outline-none focus:tw-ring-2 focus:tw-ring-primary-200 tw-bg-white tw-text-primary-600 hover:tw-bg-primary-50">
          <%= "#{l(:label_sla_detail_table)} (#{@trend_detail_counts.total})" %>
        </button>
      </div>
    </div>

    <div id="sla-trend-card-chart" data-sla-trend-card-panel="chart" role="tabpanel" class="tw-flex-1 tw-min-h-0">
      <%= render 'sla_dashboard/trend_chart' %>
    </div>
    <div id="sla-trend-card-detail" data-sla-trend-card-panel="detail" role="tabpanel"
         class="hidden tw-flex-1 tw-min-h-0">
      <%= render 'sla_dashboard/detail_table',
            table_key: :trend, results: @trend_detail_results, counts: @trend_detail_counts,
            include_resolution: true, show_title: false,
            card_classes: 'tw-flex tw-flex-col tw-h-full tw-min-w-0' %>
    </div>
  </div>
</div>
