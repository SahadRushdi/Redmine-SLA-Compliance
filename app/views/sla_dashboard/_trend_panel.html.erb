<%# SLA Trend tab. The ONLY place the date range applies. The Date Range pills + custom-range %>
<%# inputs were moved here from the header filter bar; they sit OUTSIDE #sla-filter-form's DOM %>
<%# subtree, so each carries form="sla-filter-form" (HTML5 form association) to still submit as %>
<%# part of that one filter form — the same pattern the granularity pills already use. %>
<%# The date controls lead this tab from the LEFT edge, directly under the tabs, because they are %>
<%# the tab's primary control — not a trailing accessory to a sentence. The sentence that used to %>
<%# run alongside them ("Tickets within the selected window — the only view this date range %>
<%# affects.") is gone: only this tab renders these buttons, so their presence already says which %>
<%# view they scope. What is left beside them is the one fact the buttons don't state — the actual %>
<%# resolved-date window they resolve to — as subdued text, with the full explanation on hover. %>
<div class="tw-flex tw-items-center tw-flex-wrap tw-gap-x-3 tw-gap-y-2 tw-mb-6">
  <div class="tw-flex tw-flex-wrap tw-items-center tw-gap-2" role="group" aria-label="<%= l(:label_sla_filter_date_range) %>">
    <% sla_date_presets.each do |preset| %>
      <% active = @filters[:date_preset] == preset %>
      <%# Separately rounded buttons rather than one joined segmented bar: at six presets the joined %>
      <%# bar could not wrap without breaking its own rounded ends. tw-shadow-none defeats %>
      <%# Purplemine2's permanent blue 1px button box-shadow (see filter bar). %>
      <button type="button" data-sla-preset-btn="<%= preset %>"
              class="tw-px-3.5 tw-py-2 tw-text-sm tw-font-semibold tw-rounded-lg tw-border tw-border-solid tw-shadow-none tw-transition-colors focus:tw-outline-none focus:tw-ring-2 focus:tw-ring-primary-300
                     <%= active ? 'tw-bg-primary-600 tw-text-white tw-border-primary-600' : 'tw-bg-white tw-text-gray-700 tw-border-gray-200 hover:tw-bg-gray-50' %>">
        <%= sla_date_preset_label(preset) %>
      </button>
    <% end %>
  </div>
  <%= select_tag 'date_preset',
        options_for_select(sla_date_presets.map { |p| [sla_date_preset_label(p), p] }, @filters[:date_preset]),
        id: 'sla-filter-date-preset', form: 'sla-filter-form', class: 'tw-hidden' %>

  <span class="tw-text-sm tw-text-gray-400" title="<%= l(:text_sla_trend_window_hint) %>">
    <%= sla_dashboard_date_range_label(@filters[:date_range]) %>
  </span>

  <%# One LINKED range picker across both inputs (tints the days between From and To). The library %>
  <%# finds its two inputs via querySelectorAll('input') in DOM order, so From must stay first. %>
  <div id="sla-custom-range" data-sla-daterangepicker
       class="tw-flex tw-gap-2 <%= 'hidden' unless @filters[:date_preset] == 'custom' %>">
    <div>
      <%= text_field_tag 'from', @filters[:date_range]&.first&.strftime('%m/%d/%Y'), id: 'sla-filter-from',
            class: sla_input_classes, autocomplete: 'off', form: 'sla-filter-form',
            placeholder: l(:field_sla_date_from), 'aria-label': l(:field_sla_date_from) %>
    </div>
    <div>
      <%= text_field_tag 'to', @filters[:date_range]&.last&.strftime('%m/%d/%Y'), id: 'sla-filter-to',
            class: sla_input_classes, autocomplete: 'off', form: 'sla-filter-form',
            placeholder: l(:field_sla_date_to), 'aria-label': l(:field_sla_date_to) %>
    </div>
  </div>
</div>

<%# lg:tw-items-start, not items-stretch: the SLA Met card is a fixed-content tile (label, one %>
<%# percentage, one caption) and stretching it to the trend chart's height left a tall band of %>
<%# empty white under the caption. It now sits at its natural height. %>
<div class="tw-grid tw-grid-cols-1 lg:tw-grid-cols-12 tw-gap-6 tw-mb-6 lg:tw-items-start">
  <%# 2/10 rather than 3/9: the SLA Met card holds only a label, one percentage and one caption — %>
  <%# there is no second metric to fill a wider column — so the extra width read as dead space next %>
  <%# to the chart. Give the reclaimed width to the trend chart, which always uses it. %>
  <div class="lg:tw-col-span-2">
    <%= render 'sla_dashboard/sla_met_card' %>
  </div>
  <div class="lg:tw-col-span-10 tw-bg-white tw-border tw-border-gray-200 tw-rounded-xl tw-shadow-sm tw-p-5">
    <%= render 'sla_dashboard/trend_chart' %>
  </div>
</div>
