<%# Compliance-split donut for evaluated tickets only, summing to @counts.total. %>
<%# At-risk is rendered as its own ARC SEGMENT (same color family as met, a thin white border between %>
<%# them reads as an in-slice boundary marker) and as a visually distinct subset legend row, but it %>
<%# is not a 4th primary state — the legend beside the donut is the one legend for this compliance- %>
<%# state dimension (Global Rule 9), and the priority chart's own legend below reuses the same %>
<%# colors/labels rather than a conflicting mapping. Chart.js's own native legend is disabled below. %>
<%#
  ORDER: arcs and legend rows are both sorted by count, descending — biggest bucket first — rather
  than pinned to a fixed met/breached/at_risk order. Sorting server-side means the order is
  recomputed from the same @counts every render, so it can never drift from the data. `each_with_index
  … sort_by [-value, i]` keeps the sort STABLE: equal counts (very common — several states sit at 0
  on a healthy board) hold the declaration order below instead of shuffling between requests.
%>
<% met_on_track = @counts.met - @counts.at_risk %>
<% donut_arcs = [
     { key: :met,      label: l(:label_sla_chart_met_on_track), value: met_on_track },
     { key: :at_risk,  label: l(:label_sla_chart_met_at_risk),  value: @counts.at_risk },
     { key: :breached, label: sla_card_label(:breached),        value: @counts.breached }
   ].each_with_index.sort_by { |arc, i| [-arc[:value], i] }.map(&:first) %>
<%# Where each state's arc ended up after the sort — the legend rows below need these indices to %>
<%# tell the highlight JS which arc(s) they drive, and they are no longer positional constants. %>
<% arc_index = donut_arcs.each_with_index.to_h { |arc, i| [arc[:key], i] } %>
<% donut_payload = {
     labels: donut_arcs.map { |arc| arc[:label] },
     data: donut_arcs.map { |arc| arc[:value] },
     colors: donut_arcs.map { |arc| sla_chart_color(arc[:key]) },
     total: @counts.total
   } %>
<div class="tw-flex tw-flex-col tw-h-full">
  <h3 class="tw-text-base tw-font-semibold tw-text-gray-900 tw-mb-3"><%= l(:label_sla_chart_compliance_split) %></h3>

  <%# Stacked layout (chart on top, legend below) rather than side-by-side: this card now lives in %>
  <%# a one-third-width column of the three-across analytics row, where a beside-the-chart legend %>
  <%# would be crushed. Stacking uses the limited horizontal space the way the reference design does. %>
  <div class="tw-flex tw-flex-col tw-items-center tw-gap-5 tw-flex-1">
    <div class="tw-relative tw-w-44 tw-h-44 tw-flex-shrink-0">
      <canvas id="sla-donut-chart" data-chart="<%= donut_payload.to_json %>"></canvas>
      <%# The number only — no caption under it. The card row above already labels this exact figure %>
      <%# ("Open Tickets") and the section heading already says what the ring splits, so a third %>
      <%# repetition of the name added no clarity and crowded the 176px hole. %>
      <div class="tw-absolute tw-inset-0 tw-flex tw-flex-col tw-items-center tw-justify-center tw-pointer-events-none">
        <span class="tw-text-2xl tw-font-bold tw-text-gray-900"><%= @counts.total %></span>
      </div>
    </div>

    <%# Legend rows carry the arc indices they highlight (data-sla-legend-indices), looked up from %>
    <%# arc_index above rather than hardcoded — "SLA Met" highlights BOTH the on-track and at-risk %>
    <%# arcs together (they're one legend row/count here), while the At Risk subset row highlights %>
    <%# only its own arc. Click-to-highlight (dim the other arcs, not hide any of them) is wired in %>
    <%# sla_dashboard_charts.js - same behavior as the priority chart's and trend chart's legends. %>
    <%#
      At Risk is a subset of Met (the "(of Met)" hint keeps that clear) but sorts by count among the
      others and renders as a regular row — same layout/size/weight — so the legend reads as one
      consistent list ordered biggest-first, exactly like the arcs.
    %>
    <% donut_legend_rows = [
         { state: :met,      value: @counts.met,      indices: [arc_index[:met], arc_index[:at_risk]].sort },
         { state: :breached, value: @counts.breached, indices: [arc_index[:breached]] },
         { state: :at_risk,  value: @counts.at_risk,  indices: [arc_index[:at_risk]], subset: true }
       ].each_with_index.sort_by { |row, i| [-row[:value], i] }.map(&:first) %>
    <div id="sla-chart-legend" class="tw-w-full tw-space-y-2.5">
      <% donut_legend_rows.each do |row| %>
        <%# sla-legend-item carries the click affordance AND the active pill the JS toggles; the %>
        <%# -label/-value/-muted hooks let that pill recolour the count and percentage too, which %>
        <%# carry grey utilities of their own — see partials/_chart_legend.css. %>
        <div class="sla-legend-item tw-flex tw-items-center tw-justify-between tw-gap-3 tw-text-sm"
             data-sla-legend-target="sla-donut-chart" data-sla-legend-indices="<%= row[:indices].join(',') %>">
          <span class="sla-legend-label tw-inline-flex tw-items-center tw-gap-2 tw-text-gray-700">
            <span class="tw-w-2.5 tw-h-2.5 tw-rounded-full tw-inline-block tw-flex-shrink-0" style="background-color: <%= sla_chart_color(row[:state]) %>"></span>
            <%= sla_card_label(row[:state]) %>
            <% if row[:subset] %>
              <span class="sla-legend-muted tw-text-gray-400 tw-text-xs">(<%= l(:label_sla_chart_met_at_risk_hint) %>)</span>
            <% end %>
          </span>
          <span class="tw-whitespace-nowrap">
            <span class="sla-legend-value tw-font-semibold tw-text-gray-900"><%= row[:value] %></span>
            <span class="sla-legend-muted tw-text-gray-400 tw-text-xs">(<%= sla_percentage(row[:value], @counts.total) %>%)</span>
          </span>
        </div>
      <% end %>
    </div>
  </div>
</div>
