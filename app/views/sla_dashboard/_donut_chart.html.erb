<%# Compliance-split donut: 3 legend categories (met/breached/no_sla), summing to @counts.total. %>
<%# At-risk is rendered as a 4th ARC SEGMENT adjacent to "met" (same color family, a thin white %>
<%# border between them reads as an in-slice boundary marker) but is NOT a 4th legend swatch — %>
<%# the legend beside the donut (met/breached/no_sla with counts + percentages, plus a visually %>
<%# distinct "At Risk" subset row) is the one legend for this compliance-state dimension %>
<%# (Global Rule 9) - the priority chart's own legend below reuses the same colors/labels rather %>
<%# than a conflicting mapping. Chart.js's own native legend is disabled below. %>
<% met_on_track = @counts.met - @counts.at_risk %>
<% donut_payload = {
     labels: [l(:label_sla_chart_met_on_track), l(:label_sla_chart_met_at_risk),
              l(:label_sla_card_breached), l(:label_sla_card_no_sla)],
     data: [met_on_track, @counts.at_risk, @counts.breached, @counts.no_sla],
     colors: [sla_chart_color(:met), sla_chart_color(:at_risk), sla_chart_color(:breached), sla_chart_color(:no_sla)],
     total: @counts.total
   } %>
<div class="tw-flex tw-flex-col tw-h-full">
  <h3 class="tw-text-base tw-font-semibold tw-text-gray-900 tw-mb-3"><%= l(:label_sla_chart_compliance_split) %></h3>

  <div class="tw-flex tw-items-center tw-gap-6 tw-flex-1 tw-flex-wrap sm:tw-flex-nowrap">
    <div class="tw-relative tw-w-44 tw-h-44 tw-flex-shrink-0 tw-mx-auto sm:tw-mx-0">
      <canvas id="sla-donut-chart" data-chart="<%= donut_payload.to_json %>"></canvas>
      <div class="tw-absolute tw-inset-0 tw-flex tw-flex-col tw-items-center tw-justify-center tw-pointer-events-none">
        <span class="tw-text-2xl tw-font-bold tw-text-gray-900"><%= @counts.total %></span>
        <span class="tw-text-xs tw-text-gray-500"><%= sla_card_label(:total) %></span>
      </div>
    </div>

    <%# data-sla-legend-indices matches donut_payload's own data array order above (met_on_track, %>
    <%# at_risk, breached, no_sla) - "met" highlights BOTH the on-track and at-risk arcs together %>
    <%# (they're one legend row/count here), while the At Risk row below highlights just its own %>
    <%# arc. Click-to-highlight (dim the other arcs, not hide any of them) is wired in %>
    <%# sla_dashboard_charts.js - same behavior as the priority chart's and trend chart's legends. %>
    <% donut_legend_indices = { met: '0,1', breached: '2', no_sla: '3' } %>
    <div id="sla-chart-legend" class="tw-flex-1 tw-min-w-[12rem] tw-space-y-2.5">
      <% %i[met breached no_sla].each do |state| %>
        <%# sla-legend-item carries the click affordance AND the active pill the JS toggles; the %>
        <%# -label/-value/-muted hooks let that pill recolour the count and percentage too, which %>
        <%# carry grey utilities of their own — see partials/_chart_legend.css. %>
        <div class="sla-legend-item tw-flex tw-items-center tw-justify-between tw-gap-3 tw-text-sm"
             data-sla-legend-target="sla-donut-chart" data-sla-legend-indices="<%= donut_legend_indices[state] %>">
          <span class="sla-legend-label tw-inline-flex tw-items-center tw-gap-2 tw-text-gray-700">
            <span class="tw-w-2.5 tw-h-2.5 tw-rounded-full tw-inline-block tw-flex-shrink-0" style="background-color: <%= sla_chart_color(state) %>"></span>
            <%= sla_card_label(state) %>
          </span>
          <span class="tw-whitespace-nowrap">
            <span class="sla-legend-value tw-font-semibold tw-text-gray-900"><%= @counts.public_send(state) %></span>
            <span class="sla-legend-muted tw-text-gray-400 tw-text-xs">(<%= sla_percentage(@counts.public_send(state), @counts.total) %>%)</span>
          </span>
        </div>
      <% end %>

      <%# At-risk is a subset of Met (the "(of Met)" hint keeps that clear), but it's rendered as a %>
      <%# regular legend row — same layout/size/weight as met/breached/no_sla above — rather than a %>
      <%# dashed callout, so the legend reads as one consistent list. Highlights only its own arc %>
      <%# (index 1), not the whole "met" pair the row above does. %>
      <div class="sla-legend-item tw-flex tw-items-center tw-justify-between tw-gap-3 tw-text-sm"
           data-sla-legend-target="sla-donut-chart" data-sla-legend-indices="1">
        <span class="sla-legend-label tw-inline-flex tw-items-center tw-gap-2 tw-text-gray-700">
          <span class="tw-w-2.5 tw-h-2.5 tw-rounded-full tw-inline-block tw-flex-shrink-0" style="background-color: <%= sla_chart_color(:at_risk) %>"></span>
          <%= l(:label_sla_card_at_risk) %>
          <span class="sla-legend-muted tw-text-gray-400 tw-text-xs">(<%= l(:label_sla_chart_met_at_risk_hint) %>)</span>
        </span>
        <span class="tw-whitespace-nowrap">
          <span class="sla-legend-value tw-font-semibold tw-text-gray-900"><%= @counts.at_risk %></span>
          <span class="sla-legend-muted tw-text-gray-400 tw-text-xs">(<%= sla_percentage(@counts.at_risk, @counts.total) %>%)</span>
        </span>
      </div>
    </div>
  </div>
</div>
