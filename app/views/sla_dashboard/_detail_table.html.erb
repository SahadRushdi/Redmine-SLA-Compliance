<%# Step 6.4 — ticket-level detail. Reads the exact same @scope every other part of the %>
<%# dashboard reads, filtered/sorted server-side (Sla::EffectiveState - same effective-state %>
<%# definition as the summary cards, so this table can never disagree with them). State tabs, %>
<%# sort headers, search, per-page, and pagination all resubmit as plain GET links/forms that %>
<%# preserve the active project/tracker/priority/date filters (sla_detail_table_url), matching %>
<%# the rest of the dashboard's full-page-resubmit model - no AJAX. %>
<% current_state = @state_filter == 'all' ? nil : @state_filter %>
<% detail_states = [['all', l(:label_sla_detail_state_all), @counts.total]] +
     %w[met breached at_risk no_sla].map { |s| [s, sla_card_label(s.to_sym), @counts.public_send(s)] } %>
<% detail_columns = [
     ['ticket', l(:field_sla_detail_ticket)], ['project', l(:field_sla_detail_project)],
     ['tracker', l(:field_sla_detail_tracker)], ['title', l(:field_sla_detail_title)],
     ['status', l(:field_sla_detail_status)], ['assignee', l(:field_sla_detail_assignee)],
     ['first_response', l(:field_sla_detail_first_response)], ['resolution', l(:field_sla_detail_resolution)],
     ['result', l(:field_sla_detail_result)], ['deviation', l(:field_sla_detail_deviation)]
   ] %>
<div class="tw-bg-white tw-border tw-border-gray-200 tw-rounded-lg tw-p-4 tw-shadow-sm">
  <div class="tw-flex tw-items-center tw-justify-between tw-flex-wrap tw-gap-3 tw-mb-4">
    <h3 class="tw-text-base tw-font-semibold tw-text-gray-900"><%= l(:label_sla_detail_table) %></h3>

    <div class="tw-flex tw-items-center tw-gap-3">
      <%# Reconstructs every OTHER currently-active GET param as hidden fields (generic - never %>
      <%# needs updating when a new filter param is added), so a search only ever narrows the %>
      <%# existing view rather than resetting it. Page resets since the result set is new. %>
      <%= form_tag(sla_dashboard_base_path(@project), method: :get,
                    class: 'tw-relative') do %>
        <% request.query_parameters.except('q', 'page').each do |key, value| %>
          <% Array(value).each { |v| hidden_field_tag(value.is_a?(Array) ? "#{key}[]" : key, v, id: nil) } %>
        <% end %>
        <svg class="tw-w-4 tw-h-4 tw-absolute tw-left-3 tw-top-1/2 -tw-translate-y-1/2 tw-text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
        </svg>
        <%= search_field_tag :q, @search_query, id: 'sla-detail-search', placeholder: l(:label_sla_detail_search_placeholder),
              class: "#{sla_input_classes} tw-pl-9 tw-w-56" %>
      <% end %>

      <div class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-text-gray-500">
        <label for="sla-detail-per-page" class="tw-whitespace-nowrap"><%= l(:label_sla_detail_per_page) %></label>
        <%= select_tag 'sla-detail-per-page',
              options_for_select(Setting.per_page_options_array.map { |n|
                [n, sla_detail_table_url(@filters, @project, state: current_state, sort: @sort_column, sort_dir: @sort_direction,
                                          q: @search_query, per_page: n)]
              }, sla_detail_table_url(@filters, @project, state: current_state, sort: @sort_column, sort_dir: @sort_direction,
                                       q: @search_query, per_page: @detail_pages.per_page)),
              id: 'sla-detail-per-page', onchange: 'window.location.href = this.value;',
              class: 'tw-bg-gray-50 tw-border tw-border-gray-300 tw-text-gray-900 tw-text-sm tw-rounded-lg focus:tw-ring-primary-500 focus:tw-border-primary-500 tw-p-2' %>
      </div>
    </div>
  </div>

  <div id="sla-detail-state-tabs" class="tw-flex tw-flex-wrap tw-gap-2 tw-mb-4">
    <% detail_states.each do |state, label, count| %>
      <%= link_to "#{label} (#{count})",
            sla_detail_table_url(@filters, @project, state: state == 'all' ? nil : state, q: @search_query),
            class: "tw-text-xs tw-font-medium tw-rounded-full tw-px-3 tw-py-1.5 tw-transition-colors #{
              state == @state_filter ? 'tw-bg-primary-600 tw-text-white' : 'tw-bg-gray-100 tw-text-gray-600 hover:tw-bg-gray-200'}" %>
    <% end %>
  </div>

  <div class="tw-overflow-x-auto">
    <table class="tw-min-w-full tw-text-sm tw-text-left">
      <thead>
        <tr class="tw-border-b tw-border-gray-200 tw-text-gray-500">
          <% detail_columns.each do |key, label| %>
            <% next_dir = (@sort_column == key && @sort_direction == 'desc') ? 'asc' : 'desc' %>
            <th class="tw-py-2 tw-pr-4 tw-font-medium tw-whitespace-nowrap">
              <%= link_to sla_detail_table_url(@filters, @project, state: current_state, q: @search_query,
                                                sort: key, sort_dir: next_dir),
                    class: 'tw-inline-flex tw-items-center tw-gap-1 tw-text-gray-500 hover:tw-text-gray-700' do %>
                <%= label %>
                <% if @sort_column == key %>
                  <span class="tw-text-primary-600"><%= @sort_direction == 'desc' ? '↓' : '↑' %></span>
                <% end %>
              <% end %>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody id="sla-detail-table-body">
        <% @detail_results.each do |sla_result| %>
          <% issue = sla_result.issue %>
          <tr class="tw-border-b tw-border-gray-100 hover:tw-bg-gray-50" id="sla-detail-row-<%= issue.id %>">
            <td class="tw-py-2.5 tw-pr-4">
              <%= link_to "##{issue.id}", issue_path(issue), target: '_blank', rel: 'noopener',
                    class: 'tw-text-primary-600 tw-font-medium hover:tw-underline' %>
            </td>
            <td class="tw-py-2.5 tw-pr-4"><%= issue.project.name %></td>
            <td class="tw-py-2.5 tw-pr-4"><%= issue.tracker.name %></td>
            <td class="tw-py-2.5 tw-pr-4 tw-max-w-xs tw-truncate">
              <%= link_to issue.subject, issue_path(issue), target: '_blank', rel: 'noopener',
                    class: 'tw-text-gray-800 hover:tw-underline' %>
            </td>
            <td class="tw-py-2.5 tw-pr-4"><%= issue.status.name %></td>
            <td class="tw-py-2.5 tw-pr-4"><%= issue.assigned_to&.name %></td>
            <td class="tw-py-2.5 tw-pr-4 tw-whitespace-nowrap"><%= format_sla_duration(sla_result.response_seconds) %></td>
            <td class="tw-py-2.5 tw-pr-4 tw-whitespace-nowrap"><%= format_sla_duration(sla_result.resolution_seconds) %></td>
            <td class="tw-py-2.5 tw-pr-4 tw-whitespace-nowrap">
              <% effective_state = sla_result.effective_primary_state %>
              <span class="tw-inline-block tw-rounded-full tw-px-2 tw-py-0.5 tw-text-xs tw-font-medium <%= sla_card_color_classes(effective_state.to_sym) %>">
                <%= sla_card_label(effective_state.to_sym) %>
              </span>
              <% if sla_result.effective_at_risk? %>
                <span class="tw-inline-block tw-rounded-full tw-px-2 tw-py-0.5 tw-text-xs tw-font-medium <%= sla_card_color_classes(:at_risk) %>">
                  <%= l(:label_sla_card_at_risk) %>
                </span>
              <% end %>
            </td>
            <%# Gated on the raw column, not effective_primary_state: a live-reclassified breach %>
            <%# (stale persisted "met" + a passed breach_at) correctly shows the Breached badge %>
            <%# above but has no computed deviation yet - the engine hasn't run for it since it %>
            <%# breached, and this dashboard never computes SLA state live (Global Rule 4). %>
            <td class="tw-py-2.5 tw-pr-4 tw-whitespace-nowrap <%= 'tw-text-red-600 tw-font-medium' if sla_result.deviation_seconds.present? %>">
              <%= sla_result.deviation_seconds.present? ? "+#{format_sla_duration(sla_result.deviation_seconds)}" : '—' %>
            </td>
          </tr>
        <% end %>
        <% if @detail_results.empty? %>
          <tr>
            <td colspan="<%= detail_columns.size %>" class="tw-py-8 tw-text-center tw-text-gray-400">
              <%= l(:text_sla_detail_table_empty_state) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="tw-mt-4">
    <%= pagination_links_full @detail_pages %>
  </div>
</div>
