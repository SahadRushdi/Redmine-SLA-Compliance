<%# Step 6.2 — summary cards. All numbers come from Sla::ResultSummary via @counts, computed once %>
<%# in the controller from the sla_results cache — nothing here recomputes SLA state. %>
<%# Dashboard population contains evaluated tickets only. Reconciliation: total == met + breached; %>
<%# at_risk is a subset of met, shown alongside it and never added into the total. %>
<%# Card values carry stable ids (also useful for functional tests, since assigns() isn't %>
<%# available in this Rails version without rails-controller-testing). %>
<%# Every Open Tickets card uses only the shared card title/icon and its headline value. Supporting %>
<%# captions are intentionally omitted to keep this four-card row visually minimal. %>
<div class="tw-grid tw-grid-cols-1 sm:tw-grid-cols-2 lg:tw-grid-cols-4 tw-gap-4 tw-mb-6">
  <%= render 'sla_dashboard/summary_card',
        state: :total, label: sla_card_label(:total), value: @counts.total,
        value_id: 'sla-card-total-value' %>

  <%# Stale replaces the SLA Met card on this current-state row (SLA Met now lives on the SLA Trend %>
  <%# tab). Count comes from Sla::StaleSummary: open tickets with no updates past the inactivity %>
  <%# threshold an admin configured. %>
  <%# With no threshold configured the card shows an em dash, NOT 0 — "nobody has defined stale %>
  <%# here" and "nothing is stale" are different states. %>
  <%= render 'sla_dashboard/summary_card',
        state: :stale, label: sla_card_label(:stale),
        value: @stale.configured? ? @stale.count : '—',
        value_id: 'sla-card-stale-value' %>

  <%= render 'sla_dashboard/summary_card',
        state: :breached, label: sla_card_label(:breached),
        value: @counts.breached,
        value_id: 'sla-card-breached-value' %>

  <%= render 'sla_dashboard/summary_card',
        state: :at_risk, label: sla_card_label(:at_risk), value: @counts.at_risk,
        value_id: 'sla-card-at-risk-value' %>
</div>
