<%# Step 6.2 — summary cards. All numbers come from Sla::ResultSummary via @counts, computed once %>
<%# in the controller from the sla_results cache — nothing here recomputes SLA state. %>
<%# Dashboard population contains evaluated tickets only. Reconciliation: total == met + breached; %>
<%# at_risk is a subset of met, shown alongside it and never added into the total. %>
<%# Card values carry stable ids (also useful for functional tests, since assigns() isn't %>
<%# available in this Rails version without rails-controller-testing). %>
<%# Every card is the shared _summary_card partial — icon tile, short label, one big number, one %>
<%# short caption. Nothing else: no boxed explanatory banner under the number, and no (i) tooltip %>
<%# either. Each caption is the whole supporting text the card gets. %>
<div class="tw-grid tw-grid-cols-1 sm:tw-grid-cols-2 lg:tw-grid-cols-4 tw-gap-4 tw-mb-6">
  <%= render 'sla_dashboard/summary_card',
        state: :total, label: sla_card_label(:total), value: @counts.total,
        value_id: 'sla-card-total-value',
        caption: l(:label_sla_card_total_caption) %>

  <%# Stale replaces the SLA Met card on this current-state row (SLA Met now lives on the SLA Trend %>
  <%# tab). Count comes from Sla::StaleSummary: open tickets with no updates past the inactivity %>
  <%# threshold an admin configured. %>
  <%# %>
  <%# With no threshold configured the card shows an em dash, NOT 0 — "nobody has defined stale %>
  <%# here" and "nothing is stale" are different statements, and printing 0 would assert the second %>
  <%# while meaning the first. The caption is the only place that distinction is stated now that the %>
  <%# cards carry no tooltip, so the unset variant keeps the pointer to where it gets fixed. %>
  <%= render 'sla_dashboard/summary_card',
        state: :stale, label: sla_card_label(:stale),
        value: @stale.configured? ? @stale.count : '—',
        value_id: 'sla-card-stale-value',
        caption: @stale.configured? ? l(:label_sla_card_stale_caption) : l(:label_sla_card_stale_unset_caption),
        caption_id: 'sla-card-stale-hint' %>

  <%# The breached figure is a percentage with the raw count beside it, so it is assembled here %>
  <%# rather than passed as a bare number — safe_join keeps the two spans' ids intact without %>
  <%# hand-rolling html_safe over interpolated values. %>
  <%= render 'sla_dashboard/summary_card',
        state: :breached, label: sla_card_label(:breached),
        value: safe_join([
          content_tag(:span, sla_percentage(@counts.breached, @counts.total), id: 'sla-card-breached-percentage'),
          '%',
          content_tag(:span, safe_join(['(', content_tag(:span, @counts.breached, id: 'sla-card-breached-value'), ')']),
                      class: 'tw-text-xl tw-font-semibold tw-opacity-80 tw-ml-1')
        ]),
        caption: l(:text_sla_card_breached_caption, count: @counts.breached, total: @counts.total) %>

  <%= render 'sla_dashboard/summary_card',
        state: :at_risk, label: sla_card_label(:at_risk), value: @counts.at_risk,
        value_id: 'sla-card-at-risk-value',
        caption: l(:label_sla_card_at_risk_caption) %>
</div>
