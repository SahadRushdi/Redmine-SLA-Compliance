<% html_title(@project ? "#{l(:label_sla_compliance)} — #{@project.name}" : l(:label_sla_dashboard_all)) %>
<%= render 'sla_compliance/assets' %>
<% content_for :header_tags do %>
  <%= javascript_include_tag 'sla_dashboard_tabs.js', plugin: 'redmine_sla_compliance' %>
  <%= javascript_include_tag 'sla_dashboard_filters.js', plugin: 'redmine_sla_compliance' %>
  <%= javascript_include_tag 'sla_dashboard_charts.js', plugin: 'redmine_sla_compliance' %>
  <%= javascript_include_tag 'sla_dashboard_detail_table.js', plugin: 'redmine_sla_compliance' %>
<% end %>

<%# Shared template for both SlaDashboardController#index (project-level, @project set) and %>
<%# #cross_project (top-level, @project nil). %>
<%#
  TYPE SCALE — one ladder for BOTH tabs. Anything added to this dashboard picks a rung from here
  rather than inventing a size, which is what let the two tabs drift apart:

    tw-text-2xl  bold  gray-900   page title (h1, once per page)
    tw-text-4xl  bold  state hue  a summary card's headline figure — the largest thing on the page
    tw-text-base semibold gray-900  panel headings (Tickets by Priority, Compliance Split,
                                    Ticket-Level Detail, Created vs Resolved)
    tw-text-sm   semibold gray-700/900  tab labels, pill-group buttons, summary card labels
    tw-text-sm   normal   gray-700   table body text
    tw-text-xs   normal   gray-500   summary card captions, chart legends, secondary/muted text

  Colour follows the same rule: a state's hue (SlaComplianceHelper::SLA_CARD_* maps) is the ONLY
  place colour is used for meaning; everything else is gray-900 / gray-700 / gray-500 by rung.
%>
<div class="sla-plugin">
  <%# tw-bg-gray-50: Redmine's own #content background is plain white (application.css), same as %>
  <%# every card below (tw-bg-white) - without this, a white card separated only by a 1px %>
  <%# border-gray-200 and a small shadow-sm has almost no contrast against the page, especially %>
  <%# for the full-width chart/detail-table cards. The Figma reference's clear card look comes %>
  <%# from its page canvas being a light gray behind white cards, not from a heavier border - this %>
  <%# replicates that. A SEPARATE div from .sla-plugin itself, not extra classes tacked onto the %>
  <%# same element - postcss-prefix-selector rewrites every rule as a DESCENDANT of .sla-plugin %>
  <%# (`.sla-plugin .tw-bg-gray-50`, not `.sla-plugin.tw-bg-gray-50`), so a tw- utility placed on %>
  <%# .sla-plugin itself can never match its own compiled selector - it has to sit on a child. %>
  <div class="tw-bg-gray-50 tw-p-6">
    <%# Header: title/subtitle + the tracker/priority/project filters that scope BOTH tabs. %>
    <%= render 'sla_dashboard/filter_bar' %>
    <%= render 'sla_dashboard/tabs' %>

    <%# Tab 1 — Open Tickets (current live state): summary cards (with Stale in place of SLA Met) %>
    <%# and the three-across analytics row (priority, donut, detail table + its expand modal). %>
    <div data-sla-tab-panel="open">
      <%= render 'sla_dashboard/summary_cards' %>
      <%= render 'sla_dashboard/charts' %>
    </div>

    <%# Tab 2 — SLA Trend (date-scoped): date-range controls + the SLA Met card and the %>
    <%# Created vs Resolved chart. Hidden until selected (client-side, sla_dashboard_tabs.js). %>
    <div data-sla-tab-panel="trend" class="hidden">
      <%= render 'sla_dashboard/trend_panel' %>
    </div>
  </div>
</div>
